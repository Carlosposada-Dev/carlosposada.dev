# Cloudflare Pages — HTTP headers
# https://developers.cloudflare.com/pages/configuration/headers/
#
# IMPORTANT: this file must end up in the build output (dist/), so it lives in
# public/ — Astro copies public/ verbatim. A _headers file in the repo root is
# never deployed and is silently ignored.
#
# Syntax is NOT TOML: a path pattern, then two-space-indented "Header: value"
# lines. Applies to static assets; SSR routes under /api/* are served by the
# Worker and set their own headers.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  # CSP — every allowed origin below is actually used by the site:
  #   fonts.googleapis.com  → Google Fonts + Material Symbols stylesheets
  #   fonts.gstatic.com     → the font files themselves
  #   cdn.jsdelivr.net      → Mermaid, dynamically imported in blog posts
  #   *.cloudflareinsights.com → Web Analytics beacon (Feature #11, still off)
  #   img-src https:        → Credly badges, Unsplash project images
  # 'unsafe-inline' in script-src is still required: Astro inlines small
  # component scripts. Replace with hashes/nonces before removing it.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cdn.jsdelivr.net https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Immutable, content-hashed build assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Own images — long cache, revalidate in the background.
# Do NOT add a /*.png rule on top of this: matching rules are concatenated and
# the header ends up duplicated.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The CV is replaced from time to time — keep it short
/carlos-posada-cv.pdf
  Cache-Control: public, max-age=3600

# Command palette / 404 terminal search index — regenerated on every build.
# Short max-age so a new post shows up in search minutes after a deploy, with
# stale-while-revalidate so the fetch still feels instant from cache.
/search-index.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
