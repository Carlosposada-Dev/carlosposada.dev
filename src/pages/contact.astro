---
/**
 * contact.astro — Contact
 * El formulario es la petición (`POST /api/contact`) y los canales, el panel
 * del endpoint. La malla de fondo va en verde, como el "deployed" de la home.
 */
import PageLayout from "@layouts/PageLayout.astro";
import ParticleField from "@components/global/ParticleField.astro";
import PageHero from "@components/ui/PageHero.astro";
import ContactForm from "@components/contact/ContactForm.astro";
import ContactMethods from "@components/contact/ContactMethods.astro";
---

<PageLayout
  title="Contact"
  description="Hire Carlos Posada — Cloud & DevOps Engineer. Available for full-time roles, freelance infrastructure projects, and consulting. Based in Medellín, Colombia."
  schemaType="contact"
>
  <ParticleField preset="contact" />
  <div class="page-wrap">
    <PageHero
      eyebrow="$ curl -X POST https://carlosposada.dev/api/contact"
      title="Contact"
      lede="Full-time remote Cloud, DevOps and SRE roles, freelance infrastructure and automation projects, technical collaboration."
    />
    <div class="page-section contact-grid">
      <ContactForm />
      <ContactMethods />
    </div>
  </div>
</PageLayout>
