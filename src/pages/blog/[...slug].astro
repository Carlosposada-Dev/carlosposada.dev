---
/**
 * blog/[...slug].astro — Individual Blog Post Page
 * Dynamic route — generates one page per blog post.
 * Mismo lenguaje que las páginas internas: malla ambiental de partículas,
 * cabecera mono + título grande, el TOC como pipeline y los bloques de código
 * como terminales con su host (ver utils/shiki-terminal.ts).
 */
import { getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import ParticleField from "@components/global/ParticleField.astro";
import TableOfContents from "@components/blog/TableOfContents.astro";
import NewsletterCTA from "@components/blog/NewsletterCTA.astro";
import { formatDate } from "@utils/helpers";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length > 2;
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.coverImage}
  ogImageAlt={post.data.coverImageAlt}
  ogType="article"
  publishedDate={post.data.publishedDate.toISOString()}
  schemaType="article"
>
  <ParticleField preset="blog" />
  <article class="page-wrap" id="post-article">

    <header class="post-hero" data-hero>
      <span class="reveal-line">
        <span class="stage-eyebrow post-hero-eyebrow" style="--d: 100ms">
          <a href="/blog" class="link-draw text-primary">← blog/</a>
          <span>$ cat {post.slug}.md</span>
        </span>
      </span>
      <h1 class="post-hero-title reveal-line"><span style="--d: 200ms">{post.data.title}</span></h1>
      <p class="page-lede reveal-fade" style="--d: 400ms">{post.data.description}</p>
      <div class="reveal-fade flex flex-col gap-3" style="--d: 550ms">
        <div class="post-meta">
          <time datetime={post.data.publishedDate.toISOString()}>{formatDate(post.data.publishedDate)}</time>
          <span class="text-primary">{post.data.category}</span>
          {post.data.readingTime && <span>{post.data.readingTime}</span>}
          {post.data.updatedDate && (
            <span>Updated <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></span>
          )}
        </div>
        <span class="dep-slug font-mono">{post.data.tags.map((t) => `#${t}`).join("  ")}</span>
      </div>
    </header>

    <div class:list={["post-layout", hasToc && "has-toc"]}>
      <div class="min-w-0">
        {hasToc && (
          <div class="lg:hidden">
            <TableOfContents headings={tocHeadings} variant="mobile" />
          </div>
        )}

        <!-- Post content — Tailwind Typography prose; los bloques de código son not-prose -->
        <div
          id="post-body"
          class="prose prose-invert prose-lg max-w-none
                 prose-headings:font-headline prose-headings:tracking-tight prose-headings:scroll-mt-28
                 prose-h2:text-on-surface prose-h2:border-b prose-h2:border-outline-variant/20 prose-h2:pb-2
                 prose-h3:text-on-surface
                 prose-p:text-on-surface-variant prose-p:leading-relaxed
                 prose-a:text-primary prose-a:no-underline hover:prose-a:underline
                 prose-strong:text-on-surface
                 prose-code:text-secondary prose-code:bg-surface-container-low
                 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
                 prose-code:before:content-none prose-code:after:content-none
                 prose-blockquote:border-primary prose-blockquote:text-on-surface-variant
                 prose-th:text-on-surface prose-td:text-on-surface-variant
                 prose-img:rounded-xl prose-img:border prose-img:border-outline-variant/20"
        >
          <Content />
        </div>

        <NewsletterCTA />

        <footer class="post-end">
          <div>
            <p class="font-headline font-bold text-on-surface">Carlos Posada</p>
            <p class="text-sm text-on-surface-variant">Cloud & DevOps Engineer · AI Solutions Lead</p>
          </div>
          <a href="/blog" class="link-draw font-mono text-sm text-primary">← git log blog/</a>
        </footer>
      </div>

      {hasToc && (
        <aside class="hidden lg:block" aria-label="Table of contents">
          <TableOfContents headings={tocHeadings} variant="sidebar" />
        </aside>
      )}
    </div>
  </article>
</PageLayout>

<script>
  // Copiar desde la cabecera de cada bloque (utils/shiki-terminal.ts). Delegado en
  // document para sobrevivir a View Transitions; el botón nace oculto sin JS.
  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element).closest?.<HTMLButtonElement>("[data-copy]");
    const code = btn?.closest(".code-block")?.querySelector("pre")?.textContent;
    if (!btn || code == null) return;
    try {
      await navigator.clipboard.writeText(code);
      btn.textContent = "copied";
      btn.classList.add("is-copied");
    } catch {
      btn.textContent = "ctrl+c";
    }
    setTimeout(() => {
      btn.textContent = "copy";
      btn.classList.remove("is-copied");
    }, 1600);
  });

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => (b.hidden = false));
  });

  // Mermaid diagram rendering (Feature #23)
  // Dynamic import: loads mermaid.js from CDN only when the post has mermaid blocks.
  // Zero cost on posts without diagrams. Shiki deja el lenguaje en data-language
  // del <pre>: el <code> no lleva clase language-*.
  document.addEventListener("astro:page-load", async () => {
    const blocks = document.querySelectorAll<HTMLElement>('#post-body pre[data-language="mermaid"]');
    if (!blocks.length) return;

    const { default: mermaid } = await import(
      "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs"
    );

    mermaid.initialize({
      startOnLoad: false,
      theme: "dark",
      themeVariables: {
        primaryColor: "#131929",
        primaryTextColor: "#e2e4f6",
        primaryBorderColor: "#6dddff33",
        lineColor: "#6dddff",
        background: "#0a0e1a",
        mainBkg: "#131929",
        nodeBorder: "#6dddff40",
        clusterBkg: "#0d1526",
        titleColor: "#6dddff",
        edgeLabelBackground: "#0a0e1a",
        fontFamily: "JetBrains Mono, monospace",
        fontSize: "14px",
        secondaryColor: "#0d1e3d",
        tertiaryColor: "#0d1526",
        secondaryBorderColor: "#82a3ff33",
        tertiaryBorderColor: "#2ff80133",
      },
    });

    const containers: HTMLElement[] = [];

    blocks.forEach((pre) => {
      const wrapper = document.createElement("div");
      wrapper.className =
        "not-prose my-8 rounded-xl overflow-x-auto border border-outline-variant/20 " +
        "bg-surface-container-low p-6 flex justify-center";

      const mermaidEl = document.createElement("div");
      mermaidEl.textContent = pre.textContent ?? "";

      wrapper.appendChild(mermaidEl);
      pre.replaceWith(wrapper);
      containers.push(mermaidEl);
    });

    await mermaid.run({ nodes: containers });
  });
</script>
