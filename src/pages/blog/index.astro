---
/**
 * blog/index.astro — Blog
 * Los posts como un log: fecha y categoría en mono, título a gran escala,
 * descripción y tags como texto. Sin portadas ni tarjetas: el texto manda.
 */
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import ParticleField from "@components/global/ParticleField.astro";
import PageHero from "@components/ui/PageHero.astro";
import PageCta from "@components/ui/PageCta.astro";
import { formatDate } from "@utils/helpers";

// Posts publicados, del más nuevo al más viejo
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
---

<PageLayout
  title="Blog"
  description="Technical articles on Cloud, DevOps, QA Automation, and AI by Carlos Posada — deep dives into Terraform, Kubernetes, CI/CD pipelines, LLMs, and more."
  schemaType="blog"
>
  <ParticleField preset="blog" />
  <div class="page-wrap">
    <PageHero
      eyebrow="$ git log --oneline blog/"
      title="Blog"
      lede="Reproducible write-ups on cloud, DevOps, QA automation and AI — including the parts that broke. No paywalls, no fluff."
    />

    <section class="page-section" aria-labelledby="posts-heading">
      <div class="page-section-head">
        <span class="stage-eyebrow text-tertiary">{posts.length} post{posts.length !== 1 ? "s" : ""} · newest first</span>
        <h2 id="posts-heading" class="sr-only">All posts</h2>
      </div>

      {posts.length === 0 ? (
        <p class="page-lede">The first post is almost ready. Follow along on <a href="/rss.xml" class="link-draw">RSS</a>.</p>
      ) : (
        <ol class="post-log">
          {posts.map((post, i) => (
            <li class="post-row scroll-reveal fade-up" style={`--reveal-delay: ${Math.min(i, 4) * 80}ms`}>
              <div class="post-meta">
                <time datetime={post.data.publishedDate.toISOString()}>{formatDate(post.data.publishedDate)}</time>
                <span class="text-primary">{post.data.category}</span>
                {post.data.readingTime && <span>{post.data.readingTime}</span>}
                {post.data.featured && <span class="text-secondary">● featured</span>}
              </div>
              <h3 class="post-title"><a href={`/blog/${post.slug}`} class="link-draw">{post.data.title}</a></h3>
              <p class="post-desc">{post.data.description}</p>
              <span class="dep-slug">{post.data.tags.map((t) => `#${t}`).join("  ")}</span>
            </li>
          ))}
        </ol>
      )}
    </section>

    <PageCta />
  </div>
</PageLayout>
