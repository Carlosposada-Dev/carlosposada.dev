---
/**
 * about.astro — About
 * Cabecera con el título en partículas, perfil (retrato + bio), carrera como
 * releases y la pared de certificaciones (Certifications.astro).
 */
import PageLayout from "@layouts/PageLayout.astro";
import ParticleField from "@components/global/ParticleField.astro";
import PageHero from "@components/ui/PageHero.astro";
import PageCta from "@components/ui/PageCta.astro";
import ProfileCard from "@components/about/ProfileCard.astro";
import BioSection from "@components/about/BioSection.astro";
import CareerTimeline from "@components/about/CareerTimeline.astro";
import Certifications from "@components/about/Certifications.astro";
import { SITE } from "@utils/constants";
---

<PageLayout
  title="About Me"
  description="Carlos Posada — Cloud & DevOps Engineer and AI Solutions Lead with 10+ years of experience in AWS, Kubernetes, Terraform, and QA Automation. Based in Medellín, Colombia."
  schemaType="about"
>
  <ParticleField preset="about" />
  <div class="page-wrap">
    <PageHero
      eyebrow="$ whoami"
      title="About"
      lede={`${SITE.experience} in software engineering: QA automation first, then cloud and DevOps, now AI solutions. Kubernetes is the current focus.`}
    />

    <div class="page-section profile-grid">
      <ProfileCard />
      <BioSection />
    </div>

    <CareerTimeline />

    <div class="page-section">
      <Certifications />
    </div>

    <PageCta />
  </div>
</PageLayout>
