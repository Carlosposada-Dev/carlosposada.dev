---
/**
 * index.astro — Home
 * La página se despliega como un pipeline al hacer scroll:
 * hero → plan → apply → rollout → observe → deployed. Cada etapa es una
 * sección `[data-stage]`; ParticleField dibuja el objeto de cada una en un
 * canvas fijo y hace morph entre ellas.
 */
import PageLayout from "@layouts/PageLayout.astro";
import ParticleField from "@components/global/ParticleField.astro";
import StageRail from "@components/home/StageRail.astro";
import StageHero from "@components/home/StageHero.astro";
import StagePlan from "@components/home/StagePlan.astro";
import StageApply from "@components/home/StageApply.astro";
import StageRollout from "@components/home/StageRollout.astro";
import StageObserve from "@components/home/StageObserve.astro";
import StageDeployed from "@components/home/StageDeployed.astro";
---

<PageLayout
  title={undefined}
  description="Carlos Posada — Cloud & DevOps Engineer specializing in AWS, Terraform, Kubernetes, CI/CD pipelines, QA Automation, and AI solutions. Based in Medellín, Colombia. Open to work."
  schemaType="home"
>
  <ParticleField />
  <StageRail />
  <div class="home-stages">
    <StageHero />
    <StagePlan />
    <StageApply />
    <StageRollout />
    <StageObserve />
    <StageDeployed />
  </div>
</PageLayout>
