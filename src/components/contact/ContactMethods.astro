---
/**
 * ContactMethods.astro
 * Canales, ubicación y estado como un panel de endpoint: `dt` en mono apagado,
 * `dd` con el valor enlazado. Mismo formato que el cierre de la home.
 */
import { SITE, SOCIAL_LINKS } from "@utils/constants";
---

<div class="endpoint">
  <div class="endpoint-head"><span>channels</span><span class="text-secondary">● {SOCIAL_LINKS.length + 1} reachable</span></div>
  <div class="endpoint-body">
    <dl class="endpoint-links">
      <dt>email</dt>
      <dd><a href={`mailto:${SITE.email}`} class="link-draw">{SITE.email}</a></dd>
      {SOCIAL_LINKS.map((link) => (
        <>
          <dt>{link.label.toLowerCase()}</dt>
          <dd><a href={link.href} class="link-draw" target="_blank" rel="noopener noreferrer">{link.href.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")}</a></dd>
        </>
      ))}
    </dl>
    <dl class="endpoint-links">
      <dt>location</dt>
      <dd>{SITE.location}</dd>
      <dt>timezone</dt>
      <dd>{SITE.timezone}</dd>
      {SITE.openToWork && (
        <>
          <dt>status</dt>
          <dd class="text-secondary">open to work</dd>
        </>
      )}
    </dl>
  </div>
</div>
