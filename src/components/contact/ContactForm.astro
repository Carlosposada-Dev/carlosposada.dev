---
/**
 * ContactForm.astro
 * El formulario como una petición: cabecera `POST /api/contact`, campos en mono
 * y la respuesta del Worker pintada como código HTTP.
 * - Validación client-side antes de enviar
 * - Submit via fetch al Cloudflare Worker en /api/contact
 * - Estados: idle | loading | success | error, anunciados con aria-live
 */
---

<div class="endpoint">
  <div class="endpoint-head"><span>POST /api/contact</span><span class="text-secondary">● healthy</span></div>
  <form id="contact-form" class="request-body" novalidate aria-label="Contact form">
    <div class="request-grid">
      <div class="request-field">
        <label for="name">name</label>
        <input id="name" name="name" type="text" autocomplete="name" placeholder="Jane Doe" required minlength="2" aria-required="true" aria-describedby="name-error" />
        <p id="name-error" class="field-error hidden" role="alert"></p>
      </div>
      <div class="request-field">
        <label for="email">email</label>
        <input id="email" name="email" type="email" autocomplete="email" placeholder="jane@company.com" required aria-required="true" aria-describedby="email-error" />
        <p id="email-error" class="field-error hidden" role="alert"></p>
      </div>
    </div>

    <div class="request-field">
      <label for="inquiry">inquiry</label>
      <div class="relative">
        <select id="inquiry" name="inquiry" aria-required="true">
          <option value="hiring">Hiring (full-time)</option>
          <option value="freelance">Freelance project</option>
          <option value="collaboration">Collaboration</option>
          <option value="other">Other</option>
        </select>
        <span class="material-symbols-outlined request-chevron" aria-hidden="true">expand_more</span>
      </div>
    </div>

    <div class="request-field">
      <label for="message">message</label>
      <textarea id="message" name="message" rows="6" placeholder="The infrastructure, the goal, the timeline." required minlength="10" aria-required="true" aria-describedby="message-error"></textarea>
      <p id="message-error" class="field-error hidden" role="alert"></p>
    </div>

    <button id="submit-btn" type="submit" class="btn-solid w-full justify-center">
      <span id="btn-label">Send request</span>
      <span id="btn-icon" class="material-symbols-outlined text-lg" aria-hidden="true">arrow_forward</span>
    </button>

    <div id="form-status" class="request-status hidden" role="status" aria-live="polite" aria-atomic="true"></div>

    <p class="stage-note m-0 normal-case tracking-normal">
      By submitting, you agree to the <a href="/privacy" class="link-draw text-on-surface">privacy policy</a>.
      Response time is typically within 24 hours.
    </p>
  </form>
</div>

<script>
  /**
   * Lógica del formulario de contacto.
   * 1. Valida campos client-side antes de enviar.
   * 2. Hace fetch POST a /api/contact (Cloudflare Worker).
   * 3. Pinta la respuesta como código HTTP: idle → loading → success / error.
   *
   * Se enlaza en `astro:page-load`: un módulo sólo se ejecuta una vez, así que
   * llegando por View Transitions el formulario no tendría handler y el envío
   * nativo pondría los campos en la URL.
   */
  type FormState = "idle" | "loading" | "success" | "error";

  function init() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
    const btnLabel = document.getElementById("btn-label");
    const btnIcon = document.getElementById("btn-icon");
    const statusEl = document.getElementById("form-status");
    if (!form || !submitBtn || !btnLabel || !btnIcon || !statusEl || form.dataset.bound) return;
    form.dataset.bound = "1";

    function setStatus(state: FormState, message = "") {
      statusEl!.className = "request-status";
      if (state === "idle") {
        statusEl!.classList.add("hidden");
        statusEl!.textContent = "";
        return;
      }
      statusEl!.classList.add(`is-${state}`);
      statusEl!.textContent = message;
    }

    function showFieldError(fieldId: string, msg: string) {
      const errorEl = document.getElementById(`${fieldId}-error`);
      if (errorEl) {
        errorEl.textContent = msg;
        errorEl.classList.remove("hidden");
      }
      document.getElementById(fieldId)?.classList.add("is-invalid");
    }

    function clearFieldErrors() {
      form!.querySelectorAll<HTMLElement>(".field-error").forEach((el) => {
        el.textContent = "";
        el.classList.add("hidden");
      });
      form!.querySelectorAll("input, textarea, select").forEach((el) => el.classList.remove("is-invalid"));
    }

    function validate(data: FormData): boolean {
      let valid = true;
      const name = (data.get("name") as string)?.trim();
      const email = (data.get("email") as string)?.trim();
      const message = (data.get("message") as string)?.trim();

      if (!name || name.length < 2) {
        showFieldError("name", "Please enter your full name (min. 2 characters).");
        valid = false;
      }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showFieldError("email", "Please enter a valid email address.");
        valid = false;
      }
      if (!message || message.length < 10) {
        showFieldError("message", "Message must be at least 10 characters.");
        valid = false;
      }
      return valid;
    }

    function setButtonState(loading: boolean) {
      submitBtn!.disabled = loading;
      btnLabel!.textContent = loading ? "Sending…" : "Send request";
      btnIcon!.textContent = loading ? "progress_activity" : "arrow_forward";
      btnIcon!.classList.toggle("animate-spin", loading);
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearFieldErrors();
      setStatus("idle");

      const data = new FormData(form);
      if (!validate(data)) return;

      setButtonState(true);
      setStatus("loading", "→ POST /api/contact …");

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: (data.get("name") as string).trim(),
            email: (data.get("email") as string).trim(),
            inquiry: data.get("inquiry") as string,
            message: (data.get("message") as string).trim(),
          }),
        });

        if (response.ok) {
          setStatus("success", `HTTP/2 ${response.status} OK — message received. I'll reply within 24 hours.`);
          form.reset();
        } else {
          // El Worker devuelve JSON con un campo `error`
          const body = await response.json().catch(() => ({}));
          setStatus("error", `HTTP/2 ${response.status} — ${(body as { error?: string }).error || "Server error. Please try again."}`);
        }
      } catch {
        setStatus("error", "Connection error — check your network and try again.");
      } finally {
        setButtonState(false);
      }
    });

    // Limpiar error de campo al escribir
    form.querySelectorAll("input, textarea").forEach((el) => {
      el.addEventListener("input", () => {
        const errorEl = document.getElementById(`${(el as HTMLElement).id}-error`);
        if (errorEl) {
          errorEl.textContent = "";
          errorEl.classList.add("hidden");
        }
        el.classList.remove("is-invalid");
      });
    });
  }

  document.addEventListener("astro:page-load", init);
</script>
