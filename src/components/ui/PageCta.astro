---
/**
 * PageCta.astro — cierre de las páginas internas: el contacto como endpoint.
 * Sustituye al antiguo CTABanner (gradiente + glow).
 */
import { SITE } from "@utils/constants";

export interface Props {
  title?: string;
}

const { title = "The only thing left to provision is the conversation." } = Astro.props;
---

<section class="page-cta" aria-labelledby="page-cta-heading">
  <span class="stage-eyebrow text-secondary">service/contact ● healthy</span>
  <h2 id="page-cta-heading" class="page-cta-title">{title}</h2>
  <div class="flex flex-wrap items-center gap-7">
    <div class="magnet" data-magnet>
      <a href="/contact" class="btn-solid">
        Start a conversation
        <span class="material-symbols-outlined text-lg" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
    <a href={`mailto:${SITE.email}`} class="link-draw font-mono text-sm text-on-surface">{SITE.email}</a>
  </div>
  <span class="stage-note normal-case tracking-normal">Response time is typically within 24 hours.</span>
</section>
