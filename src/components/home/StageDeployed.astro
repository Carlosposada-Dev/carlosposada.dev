---
/**
 * StageDeployed.astro — etapa 5 de 5.
 * La malla se asienta en verde y, con el scroll, las partículas escriben
 * "200 OK" sobre `[data-ok]` (un fantasma decorativo). El CTA es el endpoint.
 */
import { SITE, SOCIAL_LINKS } from "@utils/constants";
---

<section id="stage-deployed" data-stage="deployed" class="stage-deployed" aria-labelledby="deployed-heading">
  <span class="ok-ghost" data-ok data-text="200 OK" aria-hidden="true">200 OK</span>
  <span class="stage-eyebrow text-secondary">05 — deployed · service/contact ● healthy</span>
  <h2 id="deployed-heading" class="deployed-h2">Deployed<span class="text-secondary">.</span></h2>

  <div class="grid grid-cols-1 items-end gap-10 lg:grid-cols-2 lg:gap-16">
    <div class="flex flex-col gap-6">
      <p class="m-0 max-w-xl font-headline text-2xl font-medium leading-snug tracking-tight md:text-3xl">
        The only thing left to provision is the conversation.
      </p>
      <div class="flex flex-wrap items-center gap-7">
        <div class="magnet" data-magnet>
          <a href="/contact" class="btn-solid">
            Start a conversation
            <span class="material-symbols-outlined text-lg" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
        <a href="/carlos-posada-cv.pdf" class="link-draw font-headline font-medium text-on-surface">Download CV</a>
      </div>
      <span class="stage-note normal-case tracking-normal">Response time is typically within 24 hours.</span>
    </div>

    <div class="endpoint">
      <div class="endpoint-head"><span>service/contact</span><span class="text-secondary">● healthy</span></div>
      <div class="endpoint-body">
        <p class="m-0 truncate"><span class="text-on-surface-variant">$</span> curl -X POST {SITE.url}/api/contact</p>
        <p class="m-0 text-secondary">HTTP/2 200 OK</p>
        <dl class="endpoint-links">
          <dt>email</dt>
          <dd><a href={`mailto:${SITE.email}`} class="link-draw">{SITE.email}</a></dd>
          {SOCIAL_LINKS.map((link) => (
            <>
              <dt>{link.label.toLowerCase()}</dt>
              <dd><a href={link.href} class="link-draw" target="_blank" rel="noopener noreferrer">{link.href.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")}</a></dd>
            </>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
