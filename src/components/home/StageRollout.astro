---
/**
 * StageRollout.astro — etapa 3 de 5, pinned en desktop.
 * El anillo de ParticleField se divide en un arco por deployment: "shipped" se
 * llena al 100 %; "building" no tiene un dato real de progreso, así que su arco
 * se pinta como rolling update en curso, sin porcentaje. Las etiquetas las
 * coloca el script junto a su arco.
 */
import { DEPLOYMENTS } from "@utils/constants";
---

<section id="stage-rollout" data-stage="rollout" class="stage-pin stage-pin-rollout" aria-labelledby="rollout-heading">
  <div class="stage-sticky">
    <div class="flex flex-col gap-3">
      <span class="stage-eyebrow text-primary">03 — rollout · $ kubectl rollout status</span>
      <h2 id="rollout-heading" class="stage-h2">Rolling out the work. Honest states only.</h2>
    </div>

    <div class="stage-box stage-box-rollout" data-box="rollout">
      {DEPLOYMENTS.map((d) => (
        <div class="stage-label dep-label" data-dep-lbl>
          <span class="dep-slug">deployment/{d.slug}</span>
          <a href={d.href} class="dep-name link-draw">{d.name}</a>
          <span class={d.status === "shipped" ? "text-secondary" : "text-warning"}>
            ● {d.status}{d.status === "building" && " · in progress"}
          </span>
          <span class="dep-slug">{d.stack}</span>
        </div>
      ))}
    </div>

    <div class="stage-foot">
      <span>shipped = public and live · building = in flight, see /now</span>
      <a href="/work" class="link-draw font-headline text-base font-bold text-primary">All work →</a>
    </div>
  </div>
</section>
