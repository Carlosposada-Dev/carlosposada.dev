---
/**
 * StagePlan.astro — etapa 1 de 5, pinned en desktop.
 * El perfil como `terraform plan`, tecleado al ritmo del scroll por el script
 * de ParticleField (`[data-seg]`; sin JS se ve completo). Los 11 pods de "apply" nacen sobre el
 * número de certificaciones (`data-key="eleven"`).
 * El plan completo va en un <pre> sólo para lectores de pantalla.
 */
import { SITE, CERTIFICATIONS } from "@utils/constants";
import { getTrackProgress } from "@utils/helpers";

type Tone = "add" | "key" | "val" | "muted";
interface Seg { text: string; tone: Tone; key?: string }

const track = getTrackProgress()[0];
const attrs: Array<[string, string, string?]> = [
  ["role", `"${SITE.role}"`],
  ["location", `"${SITE.location} · ${SITE.timezone}"`],
  ["experience", `"${SITE.experience}"`],
  ["certifications", String(CERTIFICATIONS.length), "eleven"],
  ...(track ? [[track.label.toLowerCase(), `"${track.earned} of ${track.total}"`] as [string, string]] : []),
  ...(SITE.openToWork ? [["status", '"open to work"'] as [string, string]] : []),
];
const pad = Math.max(...attrs.map(([k]) => k.length));

const lines: Seg[][] = [
  [{ text: "Terraform will perform the following actions:", tone: "muted" }],
  [],
  [{ text: "+ ", tone: "add" }, { text: "resource ", tone: "key" }, { text: '"engineer" "carlos_posada"', tone: "val" }, { text: " {", tone: "key" }],
  ...attrs.map(([k, v, key]): Seg[] => [
    { text: "+   ", tone: "add" },
    { text: `${k.padEnd(pad)} = `, tone: "key" },
    { text: v, tone: "val", key },
  ]),
  [{ text: "  }", tone: "key" }],
  [],
  [{ text: "Plan: ", tone: "key" }, { text: "1 to add", tone: "add" }, { text: ", 0 to change, 0 to destroy.", tone: "muted" }],
];
const planText = lines.map((l) => l.map((s) => s.text).join("")).join("\n");
---

<section id="stage-plan" data-stage="plan" class="stage-pin stage-pin-plan" aria-labelledby="plan-heading">
  <div class="stage-sticky">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="flex flex-col gap-3">
        <span class="stage-eyebrow text-tertiary">01 — plan · $ terraform plan</span>
        <h2 id="plan-heading" class="stage-h2">Everything below is real state.</h2>
      </div>
      <span class="plan-state" data-plan-state>● writing</span>
    </div>
    <div class="stage-box flex items-center" data-box="plan">
      <pre class="sr-only">{planText}</pre>
      <div class="plan-code" aria-hidden="true">
        {lines.map((line) => (
          <div class="plan-line">
            {line.map((s) => <span class={`plan-${s.tone}`} data-seg={s.text} data-key={s.key}>{s.text}</span>)}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
