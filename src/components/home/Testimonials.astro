---
/**
 * Testimonials.astro
 * Sección "Verified Professional Impact".
 * Izquierda: métricas de impacto + estado/ubicación.
 * Derecha: credenciales verificables (derivadas de CERTIFICATIONS).
 *
 * Nota: aquí vivía un testimonial anónimo inventado (5 estrellas, avatares
 * JD/MS/RK, "Trusted by Global Teams"). Se retiró: prueba social falsa resta
 * credibilidad. Si algún día hay recomendaciones reales (LinkedIn, clientes),
 * moverlas a constants.ts como TESTIMONIALS con nombre, cargo y enlace.
 */
import { CERTIFICATIONS, SITE } from "@utils/constants";

// Conteo por emisor, en el orden en que aparecen en CERTIFICATIONS
const certsByIssuer = CERTIFICATIONS.reduce<
  { issuer: string; count: number; color: string; svgPath: string }[]
>((acc, cert) => {
  const row = acc.find((r) => r.issuer === cert.issuer);
  if (row) row.count += 1;
  else
    acc.push({
      issuer: cert.issuer,
      count: 1,
      color: cert.accentColor,
      svgPath: cert.svgPath,
    });
  return acc;
}, []);
---

<section
  class="py-section md:py-section-lg border-y border-outline-variant/10"
  aria-labelledby="testimonials-heading"
>
  <div class="max-w-screen-2xl mx-auto px-6 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">

      <!-- ── Columna izquierda: stats e impacto ──────── -->
      <div class="space-y-8 scroll-reveal fade-right">
        <div>
          <h2
            id="testimonials-heading"
            class="font-headline text-2xl md:text-3xl font-bold text-white mb-4"
          >
            Verified Professional Impact
          </h2>
          <p class="text-on-surface-variant leading-relaxed">
            Collaborating with cross-functional teams to deliver stable, scalable
            infrastructure that powers modern software.
          </p>
        </div>

        <!-- Métricas -->
        <div class="relative grid grid-cols-2 gap-6">
          <div class="absolute inset-0 grid-mesh-dots opacity-10 -z-10" aria-hidden="true"></div>
          <div class="terminal-block rounded-xl">
            <p class="font-headline text-3xl font-bold text-primary mb-1" data-count="50" data-suffix="+">0</p>
            <p class="text-on-surface-variant text-sm">Projects Delivered</p>
          </div>
          <div class="terminal-block rounded-xl">
            <p class="font-headline text-3xl font-bold text-secondary mb-1" data-count="99.9" data-suffix="%">0</p>
            <p class="text-on-surface-variant text-sm">Uptime SLA Met</p>
          </div>
          <div class="terminal-block rounded-xl">
            <p class="font-headline text-3xl font-bold text-tertiary mb-1" data-count="70" data-suffix="%">0</p>
            <p class="text-on-surface-variant text-sm">QA Cycle Reduction</p>
          </div>
          <div class="terminal-block rounded-xl">
            <p class="font-headline text-3xl font-bold text-primary mb-1" data-count="10" data-suffix="+">0</p>
            <p class="text-on-surface-variant text-sm">Years of Experience</p>
          </div>
        </div>

        <!-- Estado + ubicación (dato real, no social proof inventado) -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          {SITE.openToWork && (
            <span class="flex items-center gap-2">
              <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-secondary"></span>
              </span>
              <span class="font-label text-xs font-bold text-secondary uppercase tracking-widest">
                Open to Work
              </span>
            </span>
          )}
          <span class="font-mono text-xs text-on-surface-variant/70">
            {SITE.location} · {SITE.timezone}
          </span>
        </div>
      </div>

      <!-- ── Columna derecha: credenciales verificables ─────── -->
      <div class="scroll-reveal fade-left" style="--reveal-delay: 200ms;">
        <div class="glass-card p-6 md:p-8 rounded-xl relative overflow-hidden group">
          <!-- Ícono decorativo -->
          <span
            class="absolute top-0 right-0 p-4 material-symbols-outlined leading-none
                   text-primary/10 group-hover:text-primary/25 transition-colors
                   select-none pointer-events-none"
            style="font-size: 4.5rem;"
            aria-hidden="true"
          >
            verified
          </span>

          <p class="section-label text-tertiary mb-2">Independently verified</p>
          <h3 class="font-headline text-xl md:text-2xl font-bold text-white mb-6">
            {CERTIFICATIONS.length} active cloud &amp; AI certifications
          </h3>

          <!-- Desglose por emisor -->
          <ul class="space-y-3 mb-8">
            {certsByIssuer.map((row) => (
              <li class="flex items-center gap-3">
                <svg
                  class="w-4 h-4 fill-current shrink-0"
                  style={`color: ${row.color}`}
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d={row.svgPath} />
                </svg>
                <span class="font-headline text-sm font-bold text-on-surface/80">
                  {row.issuer}
                </span>
                <span class="flex-1 h-px bg-outline-variant/20" aria-hidden="true"></span>
                <span class="font-mono text-sm font-bold" style={`color: ${row.color}`}>
                  ×{row.count}
                </span>
              </li>
            ))}
          </ul>

          <a
            href="/about"
            class="inline-flex items-center gap-1.5 text-primary text-xs
                   font-label font-bold uppercase tracking-widest link-animated"
          >
            View the credential wall
            <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
          </a>

          <p class="mt-4 font-mono text-[11px] text-on-surface-variant/40">
            Every badge links to its public Credly verification page.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const counters = document.querySelectorAll('[data-count]');
    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target;
          const target = el.getAttribute('data-count');
          const suffix = el.getAttribute('data-suffix') || '';
          const isDecimal = target?.includes('.');
          const end = parseFloat(target || '0');
          const duration = 1500;
          const start = performance.now();

          function tick(now: number) {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3); // easeOutCubic
            const current = isDecimal
              ? (eased * end).toFixed(1)
              : Math.floor(eased * end);
            el.textContent = current + suffix;
            if (progress < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
          counterObserver.unobserve(el);
        }
      });
    }, { threshold: 0.5 });

    counters.forEach((c) => counterObserver.observe(c));
  });
</script>
