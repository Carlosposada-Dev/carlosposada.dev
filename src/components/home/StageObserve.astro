---
/**
 * StageObserve.astro — etapa 4 de 5, pinned en desktop.
 * Las Core Web Vitals del propio visitante en números enormes. Los valores
 * llegan de WebVitals.astro (librería web-vitals) por el evento `webvitals`;
 * ParticleField los cuenta desde 0 y luego las partículas rellenan los dígitos.
 * Lo que el navegador no expone se queda en "measuring…": nada se inventa.
 */
const VITALS = [
  { name: "LCP", title: "largest contentful paint", hint: "good ≤ 2.5 s · how soon the main content showed up" },
  { name: "INP", title: "interaction to next paint", hint: "good ≤ 200 ms · how fast it answered your click" },
  { name: "CLS", title: "cumulative layout shift", hint: "good ≤ 0.1 · nothing moved under your cursor" },
];
---

<section id="stage-observe" data-stage="observe" class="stage-pin stage-pin-observe" aria-labelledby="observe-heading">
  <div class="stage-sticky">
    <div class="flex flex-col gap-3">
      <span class="stage-eyebrow text-tertiary">04 — observe · $ kubectl top --visitor=you</span>
      <h2 id="observe-heading" class="stage-h2">These numbers are yours.</h2>
    </div>

    <div class="stage-box vitals-stage" data-box="observe">
      {VITALS.map((v) => (
        <div class="flex min-w-0 flex-col gap-2.5">
          <span class="stage-note normal-case tracking-normal">{v.name} · {v.title}</span>
          <span class="vital-num" data-vnum={v.name}>—</span>
          <span class="vital-unit" data-vunit>measuring…</span>
          <span class="stage-note normal-case tracking-normal">{v.hint}</span>
        </div>
      ))}
    </div>

    <p class="stage-foot m-0">
      Measured in your browser just now with the web-vitals library. No analytics, no cookies.
    </p>
  </div>
</section>
