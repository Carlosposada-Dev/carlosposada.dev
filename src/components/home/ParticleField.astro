---
/**
 * ParticleField.astro — el protagonista de la home.
 *
 * Un único canvas fijo cuyas partículas forman el objeto de cada etapa y hacen
 * morph de una forma a la siguiente con el scroll:
 *   hero (nombre → malla) → plan (malla baja + 11 pods sobre el "11") →
 *   apply (control plane + nodos + pods) → rollout (anillo de deployments) →
 *   observe (dígitos de los Web Vitals) → deployed (malla verde + "200 OK").
 *
 * Lee la página por data-attributes: cada etapa es `[data-stage]`, su objeto
 * vive en `[data-box]` y las etiquetas que siguen al canvas (`[data-node-lbl]`,
 * `[data-dep-lbl]`…) las posiciona el script. Todo el contenido es HTML real en
 * las secciones; el canvas es `aria-hidden`.
 */
import { HOME_DEPLOYMENTS } from "@utils/constants";
import { getIssuerNodes } from "@utils/helpers";

const config = {
  nodes: getIssuerNodes().map((n) => ({ earned: n.earned.length, pending: n.pending.length })),
  deploys: HOME_DEPLOYMENTS.map((d) => d.status),
};
---

<canvas class="field-canvas" data-field data-config={JSON.stringify(config)} aria-hidden="true"></canvas>
<div class="field-cursor field-cursor-ring" data-cursor-ring aria-hidden="true"></div>
<div class="field-cursor field-cursor-dot" data-cursor-dot aria-hidden="true"></div>

<script>
  type Status = "shipped" | "building";
  type VitalName = "LCP" | "INP" | "CLS";
  type Rating = "good" | "needs-improvement" | "poor";
  interface Config { nodes: Array<{ earned: number; pending: number }>; deploys: Status[] }
  interface Vital { name: VitalName; value: number; rating: Rating }
  interface MeshParams { amp: number; hz: number; al: number; bump: number; pulse: number }
  interface Glyphs { M: number; x: Float32Array; y: Float32Array; el: Uint8Array; rects: DOMRect[]; sz: number; t0: number }
  interface Cam { unit: number; ox: number; oy: number; cx: number; sx: number; cy: number; sy: number }
  interface NodeState { x: number; y: number; s: number; a: number; R: number; w: [number, number, number] }
  interface ApplyState extends Cam { lp: number; nodes: NodeState[]; cp: Float32Array; wcp: [number, number, number]; arr: Float32Array; cpOn: number; run: number; ready: number }
  interface RollState extends Cam { lp: number; fill: Float32Array; show: Float32Array; lab: Float32Array[] }

  const STAGES = ["hero", "plan", "apply", "rollout", "observe", "deployed"] as const;
  const RGB: Array<[number, number, number]> = [[109, 221, 255], [61, 107, 255], [109, 221, 255], [109, 221, 255], [130, 163, 255], [47, 248, 1]];
  const SPEED = [0.8, 0.5, 0.9, 0.8, 0.6, 0.3];
  // Malla por etapa: amplitud, horizonte (0–1 del alto), opacidad, reacción al cursor, pulso de despliegue
  const MESH: MeshParams[] = [
    { amp: 1, hz: 0.42, al: 1, bump: 1, pulse: 1 },
    { amp: 0.55, hz: 0.7, al: 0.45, bump: 0.45, pulse: 0 },
    { amp: 0.28, hz: 0.9, al: 0.3, bump: 0.2, pulse: 0 },
    { amp: 0.28, hz: 0.9, al: 0.3, bump: 0.2, pulse: 0 },
    { amp: 0.7, hz: 0.76, al: 0.5, bump: 0.3, pulse: 0 },
    { amp: 0.35, hz: 0.6, al: 0.85, bump: 0.6, pulse: 0 },
  ];
  // Colores fijos: 1 cresta, 2 shipped/Ready, 3 building/Pending, 4 pista gris, 5 pod/dígito, 6 pod pendiente (hueco)
  const FIXED: Array<[number, number, number]> = [[0, 0, 0], [230, 246, 255], [47, 248, 1], [242, 196, 107], [90, 100, 140], [240, 250, 255], [139, 147, 173]];
  const CP_PARTICLES = 60;

  const clamp = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
  const sm = (v: number) => v * v * (3 - 2 * v);
  const ramp = (rgb: number[]) => Array.from({ length: 24 }, (_, a) => `rgba(${rgb.join(",")},${((a + 1) / 24).toFixed(3)})`);

  class Field {
    private readonly canvas: HTMLCanvasElement;
    private readonly ctx: CanvasRenderingContext2D;
    private readonly cfg: Config;
    private readonly rm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    private readonly fine = matchMedia("(pointer: fine)").matches;
    private readonly secs: HTMLElement[];
    private readonly boxes: Array<HTMLElement | null>;
    private readonly ring: HTMLElement;
    private readonly dot: HTMLElement;
    private readonly segs: Array<HTMLElement & { _full: string; _off: number }>;
    private readonly eleven: (HTMLElement & { _full: string; _off: number }) | undefined;
    private readonly planState: HTMLElement | null;
    private readonly nodeLbls: HTMLElement[];
    private readonly cpLbl: HTMLElement | null;
    private readonly podsEl: HTMLElement | null;
    private readonly nodesEl: HTMLElement | null;
    private readonly applyStatus: HTMLElement | null;
    private readonly depLbls: HTMLElement[];
    private readonly vEls: HTMLElement[];
    private readonly uEls: HTMLElement[];
    private readonly rail: HTMLElement[];
    private readonly hero: HTMLElement | null;
    private readonly nameLines: HTMLElement[];
    private readonly okEl: HTMLElement | null;
    // índices de partículas: pods obtenidos, pods pendientes, control plane, resto
    private readonly E: number;
    private readonly P: number;
    private readonly podNode: number[] = [];
    private readonly pendNode: number[] = [];
    private readonly shellW: number[];
    private readonly shellSum: number;
    private readonly planTotal: number;

    private W = 0; private H = 0; private dpr = 1; private mobile = false; private cursorOn = false;
    private N = 0; private cols = 0; private rows = 0; private f = 1; private span = 1; private sig = 1;
    private r0 = new Float32Array(0); private r1 = new Float32Array(0); private r2 = new Float32Array(0);
    private A = new Float32Array(0); private B = new Float32Array(0); private dIdx = new Int32Array(0);
    private dust: Array<{ x: number; y: number; r: number; a: number; p: number }> = [];
    private motes: Array<{ x: number; y: number; r: number; v: number; a: number }> = [];
    private readonly tmp = new Float32Array(3);
    private styles: string[][] = FIXED.map(ramp);
    private baseKey = "";

    private time = 0; private clock = 0; private intro = 0; private last = performance.now(); private now = 0;
    private raf = 0; private dirty = true; private lastY = -1;
    private readonly m = { x: 0, y: 0, px: 0, py: 0, sx: 0, sy: 0, h: 0.35, in: false };
    private readonly cur = { x: 0, y: 0, s: 1 };
    private overLink = false; private mag: HTMLElement | null = null;
    private pulseZ = 0; private mpObs: MeshParams = MESH[4]; private mpDep: MeshParams = MESH[5];
    private br: Array<DOMRect | null> = []; private lp: number[] = [0, 0, 0, 0, 0, 0];
    private pk = -1; private act = -1; private runShown = -1; private readyShown = -1; private lblW: number[] = [];
    private pl: { x: number; y: number; w: number; h: number; on: number } | null = null;
    private pA: ApplyState | null = null; private pR: RollState | null = null;
    private vit = new Map<VitalName, Vital>();
    private vgo = 0; private vdone = 0; private vsig = ""; private vPending = false;
    private dg: Glyphs | null = null; private nameG: Glyphs | null = null; private okG: Glyphs | null = null;
    private nameTried = false; private fontsOk = !document.fonts;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext("2d")!;
      this.cfg = JSON.parse(canvas.dataset.config ?? "{}") as Config;
      const q = <T extends HTMLElement>(s: string) => document.querySelector<T>(s);
      const qa = (s: string) => Array.from(document.querySelectorAll<HTMLElement>(s));
      this.secs = STAGES.map((k) => q(`[data-stage="${k}"]`)!);
      this.boxes = STAGES.map((k) => q(`[data-box="${k}"]`));
      this.ring = q("[data-cursor-ring]")!;
      this.dot = q("[data-cursor-dot]")!;
      let off = 0;
      this.segs = qa("[data-seg]").map((s) => {
        const seg = Object.assign(s, { _full: s.dataset.seg ?? "", _off: off });
        off += seg._full.length;
        return seg;
      });
      this.planTotal = off;
      this.eleven = this.segs.find((s) => s.dataset.key === "eleven");
      this.planState = q("[data-plan-state]");
      this.nodeLbls = qa("[data-node-lbl]");
      this.cpLbl = q("[data-cp-lbl]");
      this.podsEl = q("[data-pods]");
      this.nodesEl = q("[data-nodes]");
      this.applyStatus = q("[data-apply-status]");
      this.depLbls = qa("[data-dep-lbl]");
      this.vEls = qa("[data-vnum]");
      this.uEls = qa("[data-vunit]");
      this.rail = qa("[data-rail]");
      this.hero = q("[data-hero]");
      this.nameLines = this.rm ? [] : qa("[data-name-line]");
      this.okEl = q("[data-ok]");

      this.cfg.nodes.forEach((n, j) => {
        for (let k = 0; k < n.earned; k++) this.podNode.push(j);
        for (let k = 0; k < n.pending; k++) this.pendNode.push(j);
      });
      this.E = this.podNode.length;
      this.P = this.pendNode.length;
      this.shellW = this.cfg.nodes.map((n) => n.earned + n.pending + 2);
      this.shellSum = this.shellW.reduce((a, b) => a + b, 0);
      this.intro = this.rm ? 1 : 0;

      // el cursor va en <body> para quedar por encima del navbar fijo
      document.body.append(this.ring, this.dot);
      // sin esta clase (sin JS) las etiquetas de las etapas se ven como lista en flujo
      document.documentElement.classList.add("field-on");
      if (this.rm) this.segs.forEach((s) => (s.textContent = s._full));
      document.fonts?.ready.then(() => { this.fontsOk = true; this.dg = null; this.dirty = true; });
      addEventListener("mousemove", this.onMove, { passive: true });
      document.addEventListener("mouseout", this.onOut);
      document.addEventListener("visibilitychange", this.onVis);
      document.addEventListener("webvitals", this.onVitals);
      document.dispatchEvent(new CustomEvent("webvitals:request"));
      this.layout();
      this.raf = requestAnimationFrame(this.tick);
    }

    destroy() {
      cancelAnimationFrame(this.raf);
      this.raf = 0;
      removeEventListener("mousemove", this.onMove);
      document.removeEventListener("mouseout", this.onOut);
      document.removeEventListener("visibilitychange", this.onVis);
      document.removeEventListener("webvitals", this.onVitals);
      document.documentElement.classList.remove("has-field-cursor", "field-on");
      this.ring.remove();
      this.dot.remove();
    }

    private onMove = (e: MouseEvent) => {
      const m = this.m;
      m.x = e.clientX; m.y = e.clientY;
      if (!m.in) { this.cur.x = m.x; this.cur.y = m.y; }
      m.in = true;
      const t = e.target instanceof Element ? e.target : null;
      this.overLink = !!t?.closest("a,button");
      this.magnet(t?.closest<HTMLElement>("[data-magnet]") ?? null, e);
    };

    private onOut = (e: MouseEvent) => {
      if (!e.relatedTarget) { this.m.in = false; this.magnet(null, e); }
    };

    private onVis = () => {
      if (!document.hidden && !this.raf) { this.last = performance.now(); this.raf = requestAnimationFrame(this.tick); }
    };

    private onVitals = (e: Event) => {
      for (const v of (e as CustomEvent<Vital[]>).detail) this.vit.set(v.name, v);
      this.dirty = true;
    };

    private layout() {
      this.W = innerWidth; this.H = innerHeight;
      if (!this.W || !this.H) return;
      this.mobile = this.W < 768;
      this.dpr = Math.min(devicePixelRatio || 1, this.mobile ? 1.5 : 2);
      this.canvas.width = Math.round(this.W * this.dpr);
      this.canvas.height = Math.round(this.H * this.dpr);
      const N = this.mobile ? 2600 : 6200;
      if (N !== this.N) {
        this.N = N;
        let s = 1234567;
        const rnd = () => (s = (s * 16807) % 2147483647) / 2147483647;
        this.r0 = new Float32Array(N); this.r1 = new Float32Array(N); this.r2 = new Float32Array(N);
        for (let i = 0; i < N; i++) { this.r0[i] = rnd(); this.r1[i] = rnd(); this.r2[i] = rnd(); }
        this.A = new Float32Array(N * 4); this.B = new Float32Array(N * 4);
        // la mitad de las partículas (r1 < 0.5) escribe texto: nombre, dígitos, 200 OK
        this.dIdx = new Int32Array(N);
        let dn = 0;
        const first = this.E + this.P + CP_PARTICLES;
        for (let i = 0; i < N; i++) this.dIdx[i] = i >= first && this.r1[i] < 0.5 ? dn++ : -1;
        this.dust = Array.from({ length: this.mobile ? 140 : 260 }, () => ({ x: rnd(), y: rnd(), r: rnd() * 1.1 + 0.4, a: rnd() * 0.3 + 0.06, p: rnd() * 6.28 }));
        this.motes = Array.from({ length: this.mobile ? 12 : 26 }, () => ({ x: rnd(), y: rnd(), r: rnd() * 1.6 + 1, v: rnd() * 0.012 + 0.004, a: rnd() * 0.18 + 0.05 }));
      }
      this.cols = Math.round(Math.sqrt(N * 1.8));
      this.rows = Math.ceil(N / this.cols);
      this.f = Math.max(this.W, this.H * 1.4) * 0.55;
      this.span = (this.W * 0.55 * 20) / this.f;
      this.sig = 2 * Math.pow(Math.max(this.W, this.H) * 0.12, 2);
      this.dg = null; this.okG = null; this.dirty = true; this.lblW = [];
      // al cruzar a móvil, las etiquetas del anillo vuelven al flujo
      if (this.mobile) for (const el of this.depLbls) el.removeAttribute("style");
      if (!this.m.in) { this.m.px = this.W * 0.62; this.m.py = this.H * 0.64; }
      this.cursorOn = this.fine && !this.mobile && !this.rm;
      document.documentElement.classList.toggle("has-field-cursor", this.cursorOn);
    }

    private magnet(el: HTMLElement | null, e: MouseEvent) {
      if (this.mag && this.mag !== el) {
        const a = this.mag.firstElementChild as HTMLElement | null;
        if (a) { a.style.transition = ""; a.style.transform = ""; }
        this.mag = null;
      }
      if (!el || !this.cursorOn) return;
      this.mag = el;
      const a = el.firstElementChild as HTMLElement | null, r = el.getBoundingClientRect();
      if (!a) return;
      const dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2);
      a.style.transition = "transform .25s cubic-bezier(.16,1,.3,1), background-color .24s cubic-bezier(.2,0,0,1)";
      a.style.transform = `translate(${(dx * 0.28).toFixed(1)}px,${(dy * 0.4).toFixed(1)}px)`;
    }

    // ---------- bucle ----------
    private tick = () => {
      this.raf = requestAnimationFrame(this.tick);
      if (document.hidden) { cancelAnimationFrame(this.raf); this.raf = 0; return; }
      if (innerWidth !== this.W || innerHeight !== this.H || !this.W) this.layout();
      if (!this.W) return;
      const now = performance.now(), dt = Math.min(0.05, (now - this.last) / 1000);
      this.last = now;
      const y = scrollY;
      // reduced-motion: sólo se repinta cuando cambia el scroll o llega un dato
      if (this.rm && !this.dirty && y === this.lastY && !this.vPending) return;
      this.lastY = y; this.dirty = false; this.now = now;
      const { W, H, m } = this;

      // lecturas de layout, todas antes de cualquier escritura
      const sr = this.secs.map((s) => s.getBoundingClientRect());
      const br = this.boxes.map((b) => (b ? b.getBoundingClientRect() : null));
      this.br = br;
      // ancla = centro del objeto de la etapa (o de su pantalla); el morph ocurre entre anclas
      const anc = sr.map((r, k) => { const b = br[k]; return b ? b.top + b.height / 2 : r.top + H / 2; });
      const c = H / 2;
      let k = 0;
      while (k < 5 && anc[k + 1] <= c) k++;
      let e = k < 5 ? clamp((c - anc[k]) / Math.max(1, anc[k + 1] - anc[k])) : 0;
      e = clamp((e - 0.3) / 0.4);
      if (this.rm) e = e < 0.5 ? 0 : 1;
      const nx = Math.min(5, k + 1);
      const w = [0, 0, 0, 0, 0, 0];
      w[k] += 1 - e; w[nx] += e;
      const pinned = !this.mobile && !this.rm;
      this.lp = sr.map((r, j) => {
        if (j === 0) return clamp(-r.top / H);
        if (j === 5) return clamp((H - r.top) / H);
        if (this.rm) return 1;
        if (pinned) return clamp(-r.top / Math.max(1, r.height - H));
        const b = br[j] ?? r;
        return clamp((H * 0.9 - b.top) / (H * 0.9));
      });

      const spd = SPEED[k] + (SPEED[nx] - SPEED[k]) * e;
      if (!this.rm) this.time += dt * spd;
      if (this.intro < 1) this.intro = Math.min(1, this.intro + dt / 2.2);
      this.clock += dt;
      const t = this.time;
      // sin cursor el foco deriva solo: la malla nunca se queda quieta
      const tx = m.in ? m.x : W * (0.62 + 0.1 * Math.sin(t * 0.13));
      const ty = m.in ? m.y : H * (0.64 + 0.06 * Math.cos(t * 0.17));
      const ease = this.rm ? 1 : 0.07;
      m.px += (tx - m.px) * ease; m.py += (ty - m.py) * ease;
      m.sx = (m.px / W) * 2 - 1; m.sy = (m.py / H) * 2 - 1;
      m.h += ((m.in ? 1 : 0.35) - m.h) * (this.rm ? 1 : 0.05);
      this.pulseZ = 23 - ((t * 0.14) % 1) * 24.6;
      const ph = (t % 1.25) / 1.25;
      const beat = Math.exp(-ph * 9) + (ph > 0.18 ? 0.5 * Math.exp(-(ph - 0.18) * 12) : 0);
      this.mpObs = { ...MESH[4], amp: MESH[4].amp * (1 + 0.35 * beat), al: MESH[4].al * (1 + 0.5 * beat) };
      this.mpDep = { ...MESH[5], amp: MESH[5].amp - 0.25 * this.lp[5] };

      // intro: el nombre se muestrea del propio h1, sólo si las fuentes están listas a tiempo
      if (this.nameLines.length) {
        if (!this.nameG && !this.nameTried && this.fontsOk && this.clock < 0.9) {
          this.nameTried = true;
          this.nameG = this.sampleGlyphs(this.nameLines.map((el) => ({ el, text: el.dataset.text ?? "", styleEl: el.firstElementChild as HTMLElement })), 4);
          if (this.nameG) this.nameG.t0 = this.clock;
        }
        if (this.nameG && this.clock - this.nameG.t0 < 2.2) this.nameG.rects = this.nameLines.map((el) => el.getBoundingClientRect());
      }
      if (!this.rm && this.okEl && w[5] > 0) {
        if (!this.okG && this.fontsOk) this.okG = this.sampleGlyphs([{ el: this.okEl, text: this.okEl.dataset.text ?? "" }], this.mobile ? 2 : 3);
        if (this.okG) this.okG.rects = [this.okEl.getBoundingClientRect()];
      }
      if (w[1] > 0 && this.eleven) this.prepPlan(this.lp[1]);
      if (w[2] > 0 && br[2]) this.prepApply(this.lp[2], br[2]);
      if (w[3] > 0 && br[3]) this.prepRoll(this.lp[3], br[3]);
      this.prepObs(w, br, now);

      this.ui(k, nx, e, now);
      this.draw(k, nx, e, w);
      this.labels(w);
      this.cursorFx();
    };

    // ---------- preparación por etapa ----------
    private prepPlan(lp: number) {
      const el = this.eleven!, r = el.getBoundingClientRect();
      const typed = this.pk >= el._off + el._full.length;
      this.pl = { x: r.left, y: r.top, w: r.width, h: r.height, on: typed ? (this.rm ? 1 : clamp((lp - 0.66) / 0.14)) : 0 };
    }

    private proj(C: Cam, x: number, y: number, z: number, out: Float32Array) {
      const X = x * C.cy - z * C.sy;
      let Z = x * C.sy + z * C.cy;
      const Y = y * C.cx - Z * C.sx;
      Z = y * C.sx + Z * C.cx;
      const s = 2.6 / (Z + 2.6);
      out[0] = C.ox + X * s * C.unit; out[1] = C.oy - Y * s * C.unit; out[2] = s;
    }

    private setCam(C: Cam, r: DOMRect, unit: number, rx: number, ry: number) {
      C.unit = unit; C.ox = r.left + r.width / 2; C.oy = r.top + r.height / 2;
      C.cx = Math.cos(rx); C.sx = Math.sin(rx); C.cy = Math.cos(ry); C.sy = Math.sin(ry);
    }

    private prepApply(lp: number, r: DOMRect) {
      const n = this.cfg.nodes.length;
      const P = this.pA ??= {
        unit: 1, ox: 0, oy: 0, cx: 1, sx: 0, cy: 1, sy: 0, lp: 0, cpOn: 0, run: 0, ready: 0,
        nodes: this.cfg.nodes.map(() => ({ x: 0, y: 0, s: 1, a: 0, R: 0, w: [0, 0, 0] as [number, number, number] })),
        cp: new Float32Array(3), wcp: [0, 0, 0], arr: new Float32Array(this.E),
      };
      const mob = this.mobile, m = this.m;
      const unit = mob ? Math.min(r.width, r.height) / 2.2 : Math.min(r.width / (0.8 * (n - 1) + 0.7), r.height / 1.9);
      this.setCam(P, r, unit, (mob ? 0.1 : 0.16) + m.sy * 0.08, m.sx * 0.22 + Math.sin(this.time * 0.1) * 0.08);
      P.lp = lp;
      P.wcp[1] = mob ? 0 : 0.55;
      this.cfg.nodes.forEach((nd, j) => {
        const N = P.nodes[j];
        if (mob) { const a = -Math.PI / 2 + (j * 2 * Math.PI) / n; N.w[0] = Math.cos(a) * 0.78; N.w[1] = -Math.sin(a) * 0.78; }
        else { N.w[0] = (j - (n - 1) / 2) * 0.8; N.w[1] = j % 2 ? -0.4 : -0.14; }
        N.R = (0.1 + 0.055 * Math.sqrt(nd.earned + nd.pending)) * (mob ? 0.72 : 1);
        N.a = sm(clamp((lp - (0.06 + j * (0.32 / Math.max(1, n - 1)))) / 0.14));
        this.proj(P, N.w[0], N.w[1], N.w[2], this.tmp);
        N.x = this.tmp[0]; N.y = this.tmp[1]; N.s = this.tmp[2];
      });
      this.proj(P, P.wcp[0], P.wcp[1], P.wcp[2], P.cp);
      P.cpOn = clamp(lp / 0.05);
      let run = 0;
      for (let i = 0; i < this.E; i++) {
        P.arr[i] = sm(clamp((lp - (0.5 + (i * 0.3) / Math.max(1, this.E - 1))) / 0.07));
        if (P.arr[i] >= 0.999) run++;
      }
      P.run = run;
      P.ready = P.nodes.filter((N) => N.a >= 0.999).length;
    }

    // el primer arco a la izquierda; los demás se reparten en sentido horario visto desde arriba
    private sectorMid(j: number) {
      return Math.PI + (j * 2 * Math.PI) / this.cfg.deploys.length;
    }

    private prepRoll(lp: number, r: DOMRect) {
      const D = this.cfg.deploys.length;
      const P = this.pR ??= {
        unit: 1, ox: 0, oy: 0, cx: 1, sx: 0, cy: 1, sy: 0, lp: 0,
        fill: new Float32Array(D), show: new Float32Array(D), lab: this.cfg.deploys.map(() => new Float32Array(3)),
      };
      const mob = this.mobile, m = this.m;
      // el anillo inclinado mide ~1.75 de alto y ~2.7 de ancho con sus etiquetas.
      // Móvil: ocupa el cuadrado superior de la caja; las etiquetas van debajo, en flujo
      this.setCam(P, r, mob ? r.width / 2.6 : Math.min(r.width / 4.2, r.height / 2.3), -1.05 + m.sy * 0.06, m.sx * 0.16);
      if (mob) P.oy = r.top + r.width / 2;
      P.lp = lp;
      for (let j = 0; j < D; j++) {
        P.fill[j] = clamp((lp - 0.1 - j * 0.1) / 0.38);
        P.show[j] = clamp((lp - 0.02 - j * 0.1) / 0.1);
        const a = this.sectorMid(j);
        this.proj(P, Math.cos(a) * 1.34, 0, Math.sin(a) * 1.34, P.lab[j]);
      }
    }

    private prepObs(w: number[], br: Array<DOMRect | null>, now: number) {
      if (!this.vEls.length) return;
      const ob = br[4];
      // el conteo arranca cuando la etapa domina (o, sin pin, cuando entra en pantalla)
      if (!this.vgo && (w[4] > 0.5 || ((this.mobile || this.rm) && ob && ob.top < this.H * 0.8))) this.vgo = now;
      if (this.vdone && !this.dg && !this.rm && this.fontsOk) this.sampleDigits();
      if (this.dg) this.dg.rects = this.vEls.map((el) => el.getBoundingClientRect());
    }

    private sampleDigits() {
      const items = this.vEls.map((el) => ({ el, text: this.vit.has(el.dataset.vnum as VitalName) ? el.textContent ?? "" : "" }));
      this.dg = this.sampleGlyphs(items, this.mobile ? 2 : 3);
      this.vEls.forEach((el) => el.classList.toggle("is-ghost", !!this.dg && this.vit.has(el.dataset.vnum as VitalName)));
    }

    /**
     * Muestrea texto del DOM en un canvas fuera de pantalla con su misma fuente,
     * interletrado y línea base: las partículas se posan sobre las letras reales.
     */
    private sampleGlyphs(items: Array<{ el: HTMLElement; text: string; styleEl?: HTMLElement }>, st: number): Glyphs | null {
      const xs: number[] = [], ys: number[] = [], es: number[] = [], rects: DOMRect[] = [];
      items.forEach((it, k) => {
        const r = it.el.getBoundingClientRect();
        rects.push(r);
        if (!it.text || !r.width || !r.height) return;
        const cs = getComputedStyle(it.styleEl ?? it.el);
        const fs = parseFloat(cs.fontSize), lh = parseFloat(cs.lineHeight) || fs * 0.95;
        const cv = document.createElement("canvas");
        cv.width = Math.ceil(r.width) + 8; cv.height = Math.ceil(r.height) + 8;
        const g = cv.getContext("2d", { willReadFrequently: true });
        if (!g) return;
        g.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        if ("letterSpacing" in g) (g as CanvasRenderingContext2D & { letterSpacing: string }).letterSpacing = cs.letterSpacing;
        g.fillStyle = "#fff";
        const mt = g.measureText(it.text);
        const asc = mt.fontBoundingBoxAscent || fs * 0.8, desc = mt.fontBoundingBoxDescent || fs * 0.2;
        g.fillText(it.text, 0, (lh - (asc + desc)) / 2 + asc);
        const d = g.getImageData(0, 0, cv.width, cv.height).data;
        for (let y = 0; y < cv.height; y += st) for (let x = 0; x < cv.width; x += st) {
          if (d[(y * cv.width + x) * 4 + 3] > 128) { xs.push(x); ys.push(y); es.push(k); }
        }
      });
      if (!xs.length) return null;
      return { M: xs.length, x: Float32Array.from(xs), y: Float32Array.from(ys), el: Uint8Array.from(es), rects, sz: this.mobile ? 1.5 : 1.9, t0: this.now };
    }

    // ---------- DOM ligado al scroll ----------
    private ui(k: number, nx: number, e: number, now: number) {
      if (this.hero && !this.rm) {
        const hp = this.lp[0];
        this.hero.style.transform = `translateY(${(-hp * 120).toFixed(1)}px)`;
        this.hero.style.opacity = (1 - hp * 1.15).toFixed(3);
      }
      // plan: se teclea al ritmo del scroll
      const pk = Math.floor((this.rm ? 1 : 1 - Math.pow(1 - clamp(this.lp[1] / 0.8), 2)) * this.planTotal);
      if (pk !== this.pk) {
        this.pk = pk;
        for (const s of this.segs) s.textContent = s._full.slice(0, Math.max(0, Math.min(s._full.length, pk - s._off)));
        const done = pk >= this.planTotal;
        if (this.planState) {
          this.planState.textContent = done ? "● complete" : "● writing";
          this.planState.classList.toggle("is-done", done);
        }
      }
      // vitals: cuentan desde 0 (1400 ms, out-quart) y se repintan si llega un valor nuevo
      if (this.vgo) {
        const tt = this.rm ? 1 : clamp((now - this.vgo) / 1400), ee = 1 - Math.pow(1 - tt, 4);
        const sig = Array.from(this.vit.values()).map((v) => `${v.name}${v.value}`).join("|");
        if (tt < 1 || sig !== this.vsig) {
          this.vEls.forEach((el, j) => {
            const name = el.dataset.vnum as VitalName, v = this.vit.get(name), u = this.uEls[j];
            u.classList.remove("is-good", "is-needs-improvement", "is-poor");
            if (!v) {
              el.textContent = "—";
              u.textContent = name === "INP" ? "measuring… interact with the page" : "measuring…";
              return;
            }
            el.textContent = name === "LCP" ? ((v.value / 1000) * ee).toFixed(2) : name === "INP" ? String(Math.round(v.value * ee)) : (v.value * ee).toFixed(3);
            u.textContent = `${name === "LCP" ? "s · " : name === "INP" ? "ms · " : ""}${v.rating.replace("-", " ")}`;
            u.classList.add(`is-${v.rating}`);
          });
          if (tt >= 1) {
            this.vsig = sig; this.vdone = now; this.dg = null;
            this.vEls.forEach((el) => el.classList.remove("is-ghost"));
          }
        }
        this.vPending = tt < 1;
      }
      const act = Math.max(0, (e > 0.5 ? nx : k) - 1);
      if (act !== this.act) {
        this.act = act;
        this.rail.forEach((a, i) => { a.classList.toggle("is-on", i === act); a.toggleAttribute("aria-current", i === act); });
      }
    }

    private labels(w: number[]) {
      const P = this.pA, ra = this.br[2];
      if (P && ra) {
        this.nodeLbls.forEach((el, j) => {
          const N = P.nodes[j];
          const ready = N.a >= 0.999;
          if (el.classList.contains("is-ready") !== ready) { el.classList.toggle("is-ready", ready); this.lblW[j] = 0; }
          // el ancho sólo cambia con el estado: se mide una vez por cambio
          const half = (this.lblW[j] ||= el.offsetWidth) / 2;
          const x = Math.min(Math.max(N.x - ra.left, half), ra.width - half);
          el.style.opacity = (N.a * w[2]).toFixed(3);
          el.style.transform = `translate(${x.toFixed(1)}px,${(N.y - ra.top + N.R * P.unit * N.s + 14).toFixed(1)}px) translateX(-50%)`;
        });
        if (this.cpLbl) {
          this.cpLbl.style.opacity = (P.cpOn * w[2]).toFixed(3);
          this.cpLbl.style.transform = `translate(${(P.cp[0] - ra.left).toFixed(1)}px,${(P.cp[1] - ra.top - 0.08 * P.unit - 26).toFixed(1)}px) translateX(-50%)`;
        }
        if (this.podsEl && this.runShown !== P.run) { this.runShown = P.run; this.podsEl.textContent = String(P.run); }
        if (this.nodesEl && this.readyShown !== P.ready) { this.readyShown = P.ready; this.nodesEl.textContent = String(P.ready); }
        this.applyStatus?.classList.toggle("is-on", P.lp > 0.9);
      }
      const Q = this.pR, rr = this.br[3];
      // móvil: las etiquetas del anillo van en lista bajo él (CSS), no se posicionan
      if (Q && rr && !this.mobile) {
        this.depLbls.forEach((el, j) => {
          const L = Q.lab[j], dx = L[0] - Q.ox;
          const side = dx < -10 ? "left" : dx > 10 ? "right" : "center";
          el.style.textAlign = side === "left" ? "right" : side === "right" ? "left" : "center";
          // laterales centradas en su arco; las de arriba/abajo, por fuera del anillo
          const tx = side === "left" ? "-100%" : side === "right" ? "0" : "-50%";
          const ty = side !== "center" ? "-50%" : L[1] < Q.oy ? "-100%" : "0";
          el.style.transform = `translate(${(L[0] - rr.left).toFixed(1)}px,${(L[1] - rr.top).toFixed(1)}px) translate(${tx},${ty})`;
          el.style.opacity = (Q.show[j] * w[3]).toFixed(3);
        });
      }
    }

    private cursorFx() {
      if (!this.cursorOn) return;
      const { m, cur } = this;
      cur.x += (m.x - cur.x) * 0.2; cur.y += (m.y - cur.y) * 0.2;
      cur.s += ((this.overLink ? 1.8 : 1) - cur.s) * 0.16;
      this.ring.style.transform = `translate3d(${cur.x.toFixed(1)}px,${cur.y.toFixed(1)}px,0) scale(${cur.s.toFixed(3)})`;
      this.dot.style.transform = `translate3d(${m.x.toFixed(1)}px,${m.y.toFixed(1)}px,0) scale(${this.overLink ? 0 : 1})`;
      const o = m.in ? "1" : "0";
      this.ring.style.opacity = o; this.dot.style.opacity = o;
    }

    // ---------- formas: escriben x, y, tamaño, alfa en out[o..o+3] y devuelven el color ----------
    private mesh(i: number, P: MeshParams, out: Float32Array, o: number) {
      const cols = this.cols, c = i % cols, r = (i / cols) | 0, u = r / (this.rows - 1);
      const Z = 1.45 + 18.55 * Math.pow(u, 1.5);
      const X = -this.span + (2 * this.span * (c + (r & 1) * 0.5)) / cols;
      const t = this.time, amp = P.amp, m = this.m;
      const Y = amp * (0.62 * Math.sin(X * 0.5 + t * 0.32 + Z * 0.2) * Math.cos(Z * 0.38 - t * 0.22) + 0.26 * Math.sin(X * 0.95 + Z * 1.25 + t * 0.55) + 0.14 * Math.cos(Z * 1.3 + t * 0.25 + X * 0.3));
      const s = this.f / Z;
      const sx = this.W / 2 + (X - m.sx * 1.6) * s;
      let sy = this.H * P.hz + (1.25 + m.sy * 0.18 - Y) * s * 0.8;
      const dx = sx - m.px, dy = sy - m.py, b = P.bump * m.h * Math.exp(-(dx * dx + dy * dy) / this.sig);
      const near = Math.sqrt(1.45 / Z);
      sy -= b * 46 * near;
      const fd = Math.pow(1 - u, 1.1);
      const crest = clamp((Y / (amp || 1) + 1.02) / 2.04);
      const pulse = P.pulse ? Math.exp(-((Z - this.pulseZ) * (Z - this.pulseZ)) / 1.4) * fd : 0;
      const heat = Math.max(b, pulse * 0.6);
      out[o] = sx; out[o + 1] = sy;
      out[o + 2] = 0.8 + 1.8 * near + heat * 2.2;
      out[o + 3] = P.al * fd * (0.12 + 0.88 * crest * crest) + heat * 0.55;
      return heat > 0.15 ? 1 : 0;
    }

    /** Lleva la partícula hacia un punto de texto muestreado */
    private toGlyph(G: Glyphs, gm: number, q: number, out: Float32Array, o: number) {
      const p = (gm * 7919) % G.M, rr = G.rects[G.el[p]], i = o / 4;
      const x = rr.left + G.x[p] + (this.r0[i] - 0.5) * 1.2, y = rr.top + G.y[p] + (this.r1[i] - 0.5) * 1.2;
      out[o] += (x - out[o]) * q; out[o + 1] += (y - out[o + 1]) * q;
      out[o + 2] += (G.sz - out[o + 2]) * q; out[o + 3] += (0.95 - out[o + 3]) * q;
    }

    private shape(k: number, i: number, out: Float32Array, o: number): number {
      if (k === 0) return this.mesh(i, MESH[0], out, o);
      if (k === 1) {
        const c = this.mesh(i, MESH[1], out, o), P = this.pl;
        // los pods nacen sobre el "11" de certifications = 11
        if (i < this.E && P && P.on > 0) {
          const q = sm(P.on), x = P.x + ((i + 0.5) / this.E) * P.w, y = P.y + P.h * (0.25 + (0.5 * ((i * 7) % this.E)) / Math.max(1, this.E - 1));
          out[o] += (x - out[o]) * q; out[o + 1] += (y - out[o + 1]) * q; out[o + 2] += (3.5 - out[o + 2]) * q; out[o + 3] += (1 - out[o + 3]) * q;
          return q > 0.5 ? 5 : c;
        }
        return c;
      }
      if (k === 2) return this.pA ? this.applyShape(i, out, o) : this.mesh(i, MESH[2], out, o);
      if (k === 3) return this.pR ? this.rollShape(i, out, o) : this.mesh(i, MESH[3], out, o);
      if (k === 4) {
        const c = this.mesh(i, this.mpObs, out, o), D = this.dg, gm = this.dIdx[i];
        if (!D || gm < 0) return c;
        const q = sm(clamp(((this.now - D.t0) / 1000 - this.r2[i] * 0.45) / 0.55));
        if (q <= 0) return c;
        this.toGlyph(D, gm, q, out, o);
        return q > 0.5 ? 5 : c;
      }
      // deployed: con el scroll, la mitad de las partículas forma "200 OK"
      const c = this.mesh(i, this.mpDep, out, o), G = this.okG, gm = this.dIdx[i];
      if (!G || gm < 0) return c;
      const q = sm(clamp((this.lp[5] - 0.25 - this.r2[i] * 0.3) / 0.45));
      if (q <= 0) return c;
      this.toGlyph(G, gm, q, out, o);
      return q > 0.5 ? 5 : c;
    }

    private applyShape(i: number, out: Float32Array, o: number): number {
      const P = this.pA!, T = this.tmp, t = this.time, E = this.E, PE = E + this.P;
      if (i < E) {
        // pod obtenido: espera en el control plane y se programa hacia su nodo
        const N = P.nodes[this.podNode[i]], a = P.arr[i];
        const ang = t * 0.6 + i * 1.9, rr = N.R + 0.1;
        this.proj(P, N.w[0] + rr * Math.cos(ang), N.w[1] + 0.25 * rr * Math.sin(ang), rr * Math.sin(ang), T);
        const wx = P.cp[0] + Math.cos(i * 2.4) * 10, wy = P.cp[1] + Math.sin(i * 2.4) * 10;
        out[o] = wx + (T[0] - wx) * a; out[o + 1] = wy + (T[1] - wy) * a;
        out[o + 2] = (this.mobile ? 4.5 : 6) * (1 + (T[2] - 1) * a); out[o + 3] = P.cpOn;
        return 5;
      }
      if (i < PE) {
        const N = P.nodes[this.pendNode[i - E]];
        const ap = clamp((P.lp - 0.86 - (i - E) * 0.015) / 0.06), ang = -t * 0.4 + i * 2.3, rr = N.R + 0.19;
        this.proj(P, N.w[0] + rr * Math.cos(ang), N.w[1] + 0.25 * rr * Math.sin(ang), rr * Math.sin(ang), T);
        out[o] = T[0]; out[o + 1] = T[1]; out[o + 2] = (this.mobile ? 7 : 9) * T[2]; out[o + 3] = ap * 0.9;
        return 6;
      }
      if (i < PE + CP_PARTICLES) {
        const th = this.r0[i] * 6.2832, ph = Math.acos(2 * this.r1[i] - 1), rr = 0.055;
        this.proj(P, P.wcp[0] + rr * Math.sin(ph) * Math.cos(th), P.wcp[1] + rr * Math.cos(ph), P.wcp[2] + rr * Math.sin(ph) * Math.sin(th), T);
        out[o] = T[0]; out[o + 1] = T[1]; out[o + 2] = 1.6; out[o + 3] = 0.9 * P.cpOn;
        return 1;
      }
      if (this.r0[i] < 0.5) {
        let acc = 0, j = 0;
        const pick = this.r2[i] * this.shellSum;
        for (; j < this.shellW.length - 1; j++) { acc += this.shellW[j]; if (pick < acc) break; }
        const N = P.nodes[j];
        const c = this.mesh(i, MESH[2], out, o);
        if (N.a <= 0) return c;
        const q = sm(clamp(N.a * 1.3 - this.r1[i] * 0.3));
        const th = this.r0[i] * 2 * 6.2832, ph = Math.acos(2 * this.r1[i] - 1), rr = N.R * (0.94 + 0.1 * this.r2[i]);
        this.proj(P, N.w[0] + rr * Math.sin(ph) * Math.cos(th), N.w[1] + rr * Math.cos(ph), N.w[2] + rr * Math.sin(ph) * Math.sin(th), T);
        const dep = clamp((T[2] - 0.9) / 0.23);
        out[o] += (T[0] - out[o]) * q; out[o + 1] += (T[1] - out[o + 1]) * q;
        out[o + 2] += (1.1 + 1.4 * dep - out[o + 2]) * q; out[o + 3] += (0.3 + 0.6 * dep - out[o + 3]) * q;
        return 0;
      }
      return this.mesh(i, MESH[2], out, o);
    }

    private rollShape(i: number, out: Float32Array, o: number): number {
      if (i < this.E + this.P + CP_PARTICLES || this.r0[i] >= 0.55) return this.mesh(i, MESH[3], out, o);
      const P = this.pR!, T = this.tmp, D = this.cfg.deploys.length;
      const u = this.r1[i], j = Math.min(D - 1, (u * D) | 0), v = u * D - j;
      const half = Math.PI / D - 0.09;
      const ang = this.sectorMid(j) - half + v * 2 * half, phi = this.r2[i] * 6.2832, tr = 0.065, R = 1 + tr * Math.cos(phi);
      this.proj(P, Math.cos(ang) * R, tr * Math.sin(phi), Math.sin(ang) * R, T);
      const dep = clamp((T[2] - 0.75) / 0.5);
      out[o] = T[0]; out[o + 1] = T[1];
      let lit: boolean, head: number;
      if (this.cfg.deploys[j] === "shipped") {
        const f = P.fill[j];
        lit = v < f;
        head = f > 0 && f < 1 ? Math.exp(-Math.pow((v - f) * 40, 2)) : 0;
      } else {
        // building: sin dato de progreso → un tramo que recorre el arco (rolling update en curso)
        const hv = 0.5 + 0.38 * Math.sin(this.time * 0.9 + j * 1.7);
        lit = P.fill[j] > 0 && Math.abs(v - hv) < 0.16 * P.fill[j];
        head = lit ? Math.exp(-Math.pow((v - hv) * 30, 2)) : 0;
      }
      out[o + 2] = lit ? 1.6 + 1.2 * dep : 1.2;
      out[o + 3] = lit ? 0.55 + 0.45 * dep : 0.16 + 0.12 * dep;
      if (head > 0.3) { out[o + 2] += 1.5 * head; out[o + 3] = 1; return 1; }
      return lit ? (this.cfg.deploys[j] === "shipped" ? 2 : 3) : 4;
    }

    // ---------- pintado ----------
    private draw(k: number, nx: number, e: number, w: number[]) {
      const { ctx, W, H, N, m } = this, t = this.time, sy = scrollY;
      ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
      ctx.fillStyle = "#0a0e1a";
      ctx.fillRect(0, 0, W, H);
      const base = RGB[k].map((v, j) => Math.round(v + (RGB[nx][j] - v) * e));
      const key = base.join(",");
      if (key !== this.baseKey) { this.baseKey = key; this.styles[0] = ramp(base); }
      const S = this.styles;
      // capa lejana: polvo, parallax mínimo con cursor y scroll
      for (const d of this.dust) {
        const x = d.x * W - m.sx * 12, y = (((d.y * H - sy * 0.04) % H) + H) % H;
        ctx.fillStyle = S[0][Math.min(23, (d.a * (0.65 + 0.35 * Math.sin(t * 0.7 + d.p)) * 24) | 0)];
        ctx.fillRect(x, y, d.r, d.r);
      }
      // capa media: el objeto de la etapa, con morph escalonado hacia la siguiente
      const A = this.A, B = this.B, blend = nx !== k && e > 0, iv = 1 - this.intro;
      const NG = k === 0 && this.nameG && this.clock - this.nameG.t0 < 2.2 ? this.nameG : null;
      const ct = NG ? this.clock - NG.t0 : 0;
      for (let i = 0; i < N; i++) {
        const o = i * 4;
        let col = this.shape(k, i, A, o);
        if (blend) {
          const d = this.r2[i] * 0.35, ei = sm(clamp((e - d) / (1 - d)));
          if (ei > 0) {
            const cb = this.shape(nx, i, B, o);
            A[o] += (B[o] - A[o]) * ei; A[o + 1] += (B[o + 1] - A[o + 1]) * ei;
            A[o + 2] += (B[o + 2] - A[o + 2]) * ei; A[o + 3] += (B[o + 3] - A[o + 3]) * ei;
            if (ei > 0.5) col = cb;
          }
        }
        let x = A[o], y = A[o + 1], al = A[o + 3], sz = A[o + 2];
        const a0 = this.r0[i] * 6.2832, rad = (0.2 + this.r2[i] * 0.6) * Math.max(W, H);
        const x0 = W / 2 + Math.cos(a0) * rad, y0 = H / 2 + Math.sin(a0) * rad * 0.6;
        const gm = this.dIdx[i];
        if (NG && gm >= 0) {
          // intro: la mitad de las partículas escribe el nombre, lo sostiene y se suelta en la malla
          const p = (gm * 7919) % NG.M, rr = NG.rects[NG.el[p]];
          const q1 = 1 - Math.pow(1 - clamp((ct - 0.1 - this.r1[i] * 0.3) / 0.5), 3);
          const q2 = sm(clamp((ct - 1.1 - this.r2[i] * 0.4) / 0.7));
          const gx = x0 + (rr.left + NG.x[p] - x0) * q1, gy = y0 + (rr.top + NG.y[p] - y0) * q1, ga = 0.95 * q1;
          x = gx + (x - gx) * q2; y = gy + (y - gy) * q2; al = ga + (al - ga) * q2; sz = NG.sz + (sz - NG.sz) * q2;
          if (q2 < 0.5) col = 5;
        } else if (iv > 0) {
          const di = this.r1[i] * 0.4, ii = clamp((this.intro - di) / (1 - di)), eo = 1 - Math.pow(1 - ii, 3);
          x = x0 + (x - x0) * eo; y = y0 + (y - y0) * eo; al *= eo;
        }
        if (al <= 0.02 || x < -10 || x > W + 10 || y < -10 || y > H + 10) continue;
        const bi = Math.min(23, (al * 24) | 0);
        if (col === 6) { ctx.strokeStyle = S[6][bi]; ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(x, y, sz / 2, 0, 6.2832); ctx.stroke(); continue; }
        if (col === 5 && sz > 3) { ctx.fillStyle = S[5][bi]; ctx.beginPath(); ctx.arc(x, y, sz / 2, 0, 6.2832); ctx.fill(); continue; }
        ctx.fillStyle = S[col][bi];
        ctx.fillRect(x - sz / 2, y - sz / 2, sz, sz);
      }
      // aristas control plane → nodo: crecen con el scroll, discontinuas hasta Ready
      const P = this.pA;
      if (w[2] > 0.01 && P) {
        ctx.lineWidth = 1;
        for (const n of P.nodes) {
          if (n.a <= 0) continue;
          const ready = n.a >= 0.999;
          ctx.setLineDash(ready ? [] : [3, 5]);
          ctx.strokeStyle = ready ? `rgba(109,221,255,${(0.4 * w[2]).toFixed(3)})` : `rgba(242,196,107,${(0.55 * n.a * w[2]).toFixed(3)})`;
          ctx.beginPath();
          ctx.moveTo(P.cp[0], P.cp[1]);
          ctx.lineTo(P.cp[0] + (n.x - P.cp[0]) * n.a, P.cp[1] + (n.y - P.cp[1]) * n.a);
          ctx.stroke();
        }
        ctx.setLineDash([]);
      }
      // capa cercana: motas, parallax fuerte con cursor y scroll
      for (const p of this.motes) {
        if (!this.rm) { p.y -= p.v * 0.016; if (p.y < 0) p.y += 1; }
        const y = ((((p.y * H - sy * 0.18) % (H + 40)) + H + 40) % (H + 40)) - 20, x = p.x * W - m.sx * 60;
        ctx.fillStyle = S[0][Math.min(23, (p.a * 24) | 0)];
        ctx.beginPath(); ctx.arc(x, y, p.r, 0, 6.2832); ctx.fill();
      }
    }
  }

  // Delegado en astro:page-load / astro:before-swap: sobrevive a las View Transitions
  let field: Field | null = null;
  document.addEventListener("astro:page-load", () => {
    field?.destroy();
    field = null;
    const canvas = document.querySelector<HTMLCanvasElement>("[data-field]");
    if (canvas) field = new Field(canvas);
  });
  document.addEventListener("astro:before-swap", () => {
    field?.destroy();
    field = null;
  });
</script>
