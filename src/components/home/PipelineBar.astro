---
/**
 * PipelineBar.astro
 * Barra de etapas de la home (plan → apply → rollout → observe → deployed),
 * pegada bajo el navbar. El script mide cuánto ha entrado cada escena
 * (`[data-stage]`) y publica ese progreso como `--p`: la escena lo usa para
 * revelar sus hijos y el conector de la barra para rellenarse en verde.
 */
export const STAGES = [
  { id: "plan", label: "plan" },
  { id: "apply", label: "apply" },
  { id: "rollout", label: "rollout" },
  { id: "observe", label: "observe" },
  { id: "deployed", label: "deployed" },
];
---

<nav class="pipeline" aria-label="Page stages">
  <ol class="mx-auto flex max-w-screen-2xl items-center justify-center px-4 py-3 md:px-8">
    {STAGES.map((stage, i) => (
      <>
        <li class="pipeline-stage" data-pipeline-stage>
          <a href={`#stage-${stage.id}`} class="flex items-center gap-2 no-underline">
            <span class="pipeline-dot" aria-hidden="true"></span>
            <span class:list={[i !== 0 && i !== STAGES.length - 1 && "hidden sm:inline"]}>{stage.label}</span>
          </a>
        </li>
        {i < STAGES.length - 1 && <li class="pipeline-conn" aria-hidden="true" data-pipeline-conn></li>}
      </>
    ))}
  </ol>
</nav>

<script>
  // Delegado y re-ejecutable: los nodos se consultan en cada frame, así que
  // sobrevive a las View Transitions sin re-bind.
  let ticking = false;

  function update() {
    ticking = false;
    const stages = Array.from(document.querySelectorAll<HTMLElement>("[data-stage]"));
    if (stages.length === 0) return;

    const vh = window.innerHeight;
    // Navbar fijo + esta barra: lo que cuenta es la parte del viewport bajo ellos.
    // Mismo valor que `top` de .stage-sticky en global.css.
    const HEADER = 112;
    // 0 cuando la escena asoma por el 70% del viewport, 1 cuando queda alineada
    // bajo la cabecera (o, en la pinned, justo antes de soltarse)
    const progress = stages.map((stage) => {
      const rect = stage.getBoundingClientRect();
      const top = rect.top - HEADER;
      const p = (vh * 0.7 - top) / Math.max(rect.height - vh * 0.3, 1);
      const clamped = Math.min(1, Math.max(0, p));
      stage.style.setProperty("--p", clamped.toFixed(3));
      return clamped;
    });

    let active = progress.findIndex((p) => p < 1);
    if (active === -1) active = progress.length - 1;
    // Una etapa que aún no asoma no es la activa: sigue siéndolo la anterior
    // (si no, a scroll 0 "plan" ya saldría como hecha)
    if (active > 0 && progress[active] === 0) active -= 1;

    document.querySelectorAll<HTMLElement>("[data-pipeline-stage]").forEach((el, i) => {
      el.classList.toggle("is-done", i < active);
      el.classList.toggle("is-active", i === active);
    });
    document.querySelectorAll<HTMLElement>("[data-pipeline-conn]").forEach((el, i) => {
      el.style.setProperty("--p", (i < active ? 1 : i === active ? progress[i] : 0).toFixed(3));
    });
  }

  function schedule() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  }

  window.addEventListener("scroll", schedule, { passive: true });
  window.addEventListener("resize", schedule);
  document.addEventListener("astro:page-load", update);
  update();
</script>
