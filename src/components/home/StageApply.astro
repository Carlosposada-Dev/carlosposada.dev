---
/**
 * StageApply.astro — etapa 2 de 5, pinned en desktop.
 * El clúster se ensambla con el scroll (lo dibuja ParticleField): control
 * plane, un nodo por emisor y un pod por certificación; los del roadmap
 * orbitan huecos. Aquí sólo van las etiquetas que siguen a los nodos y la
 * versión en texto para lectores de pantalla. La pared completa vive en /about.
 */
import { CERTIFICATIONS } from "@utils/constants";
import { getIssuerNodes, getTrackProgress } from "@utils/helpers";

const nodes = getIssuerNodes();
const track = getTrackProgress()[0];
---

<section id="stage-apply" data-stage="apply" class="stage-pin stage-pin-apply" aria-labelledby="apply-heading">
  <div class="stage-sticky">
    <div class="flex flex-col gap-3">
      <span class="stage-eyebrow text-primary">02 — apply · $ terraform apply -auto-approve</span>
      <h2 id="apply-heading" class="stage-h2">
        Scheduling <span class="text-primary" data-pods>{CERTIFICATIONS.length}</span> pods onto
        <span class="text-primary" data-nodes>{nodes.length}</span> nodes.
      </h2>
    </div>

    <div class="stage-box stage-box-apply" data-box="apply">
      <div class="stage-label cp-label" data-cp-lbl aria-hidden="true">control-plane</div>
      {nodes.map((node) => {
        const pending = node.pending.length ? ` · ${node.pending.length} pending` : "";
        return (
          <div class="stage-label node-label" data-node-lbl aria-hidden="true">
            <span class="node-name">{node.issuer}</span>
            <span class="node-slug">node/{node.slug}</span>
            <span class="node-state">
              <span class="node-state-pending">Pending</span>
              <span class="node-state-ready">Ready · {node.earned.length} running{pending}</span>
            </span>
            <span class="node-codes">
              {node.earned.join(" · ")}
              {node.pending.length > 0 && <span> ○ {node.pending.join(" · ")}</span>}
            </span>
          </div>
        );
      })}
      <ul class="sr-only">
        {nodes.map((node) => (
          <li>
            {node.issuer}: {node.earned.join(", ")} earned
            {node.pending.length > 0 && `; ${node.pending.join(", ")} on the roadmap`}
          </li>
        ))}
      </ul>
    </div>

    <div class="stage-foot">
      <span class="apply-status" data-apply-status>
        nodes <b class="text-secondary">{nodes.length}/{nodes.length} Ready</b> · pods
        <b class="text-secondary">{CERTIFICATIONS.length}/{CERTIFICATIONS.length} Running</b>
        {track && <> · {track.label.toLowerCase()} <b class="text-on-surface">{track.earned}/{track.total}</b></>}
      </span>
      <span>
        <span class="legend-dot" aria-hidden="true"></span>Running = earned, verifiable
        <span class="legend-ring" aria-hidden="true"></span>Pending = on the roadmap
      </span>
    </div>
  </div>
</section>
