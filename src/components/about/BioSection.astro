---
/**
 * BioSection.astro
 * Bio en tipografía grande + canales como texto (subrayado que se dibuja) y CV.
 */
import { SOCIAL_LINKS } from "@utils/constants";
---

<section class="bio" aria-labelledby="bio-heading">
  <span class="stage-eyebrow text-tertiary">01 — profile</span>
  <h2 id="bio-heading" class="stage-h2">Bridging the gap between logic and scale.</h2>
  <div class="bio-text">
    <p>
      I am Carlos, a systems architect and automation specialist dedicated to building resilient
      digital infrastructures. With over a decade of experience, I&apos;ve navigated the transition
      from manual precision to autonomous systems.
    </p>
    <p>
      My philosophy is rooted in technical elegance: the most complex infrastructure should operate
      with the rhythm of a heartbeat — consistent, quiet, and essential. Whether I&apos;m deploying
      multi-cloud environments or training AI agents for QA, my focus remains on high-velocity
      reliability.
    </p>
  </div>
  <div class="bio-links">
    {SOCIAL_LINKS.map((link) => (
      <a href={link.href} class="link-draw" target="_blank" rel="noopener noreferrer">{link.label}</a>
    ))}
    <a href="/carlos-posada-cv.pdf" class="link-draw text-primary" download>Download CV</a>
  </div>
</section>
