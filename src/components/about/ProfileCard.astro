---
/**
 * ProfileCard.astro
 * Retrato (gris → color al hover) con el estado debajo, en mono. Sin glow ni
 * badges flotantes: el estado es una línea de texto, como el resto del sitio.
 */
import { SITE } from "@utils/constants";
---

<figure class="profile">
  <div class="profile-photo">
    <img
      src="/images/portrait.webp"
      alt={`${SITE.author} — Cloud & DevOps Engineer`}
      width="424"
      height="512"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <figcaption class="profile-caption">
    <span>{SITE.location} · {SITE.timezone}</span>
    {SITE.openToWork && <span class="text-secondary">● open to work</span>}
  </figcaption>
</figure>
