---
/**
 * CareerTimeline.astro
 * La carrera como releases: periodo en mono, rol a gran escala, descripción y
 * stack como texto. La actual va marcada; las demás quedan en tono apagado.
 */
import { CAREER } from "@utils/constants";
---

<section class="page-section" aria-labelledby="career-heading">
  <div class="page-section-head">
    <span class="stage-eyebrow text-tertiary">02 — career · $ git tag --list</span>
    <h2 id="career-heading" class="stage-h2">Three releases so far.</h2>
  </div>
  <ol class="release-list">
    {CAREER.map((entry, i) => (
      <li class:list={["release scroll-reveal fade-up", entry.isCurrent && "is-current"]} style={`--reveal-delay: ${i * 90}ms`}>
        <span class="release-period">
          {entry.period.toLowerCase()}
          {entry.isCurrent && <span class="text-secondary"> ● current</span>}
        </span>
        <h3 class="release-title">{entry.title}</h3>
        <p class="release-desc">{entry.description}</p>
        <span class="dep-slug">{entry.tags.join(" · ")}</span>
      </li>
    ))}
  </ol>
</section>
