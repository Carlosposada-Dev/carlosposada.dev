---
/**
 * CareerTimeline.astro
 * La carrera como un `git log --graph`: periodo a la izquierda, una rama que se
 * dibuja al entrar en pantalla y un commit por rol. Compacto a propósito: el
 * rol es un titular mediano, no un display.
 */
import { CAREER } from "@utils/constants";
---

<section class="page-section split-section" aria-labelledby="career-heading">
  <div class="page-section-head">
    <span class="stage-eyebrow text-tertiary">02 — career · $ git log --graph --oneline</span>
    <h2 id="career-heading" class="stage-h2">{CAREER.length} releases so far.</h2>
  </div>
  <ol class="graph scroll-reveal">
    {CAREER.map((entry, i) => (
      <li class:list={["commit", entry.isCurrent && "is-current"]} style={`--i: ${i}`}>
        <span class="commit-period">{entry.period.toLowerCase()}</span>
        <span class="commit-node" aria-hidden="true"></span>
        <div class="commit-body">
          <h3 class="commit-title">
            {entry.title}
            {entry.isCurrent && <span class="commit-head">HEAD</span>}
          </h3>
          <p class="commit-desc">{entry.description}</p>
          <span class="commit-tags">{entry.tags.join(" · ")}</span>
        </div>
      </li>
    ))}
  </ol>
</section>
