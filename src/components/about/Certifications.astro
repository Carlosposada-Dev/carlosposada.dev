---
/**
 * Certifications.astro
 * La pared de credenciales en About, en el lenguaje del clúster de la home:
 * un "nodo" por emisor (icono de marca, conteo y, si lo tiene, el progreso de
 * su track) y un "pod" por certificación que aterriza al entrar en pantalla.
 * Cada pod obtenido enlaza a su verificación (Credly o Microsoft Learn) y se
 * inclina hacia el cursor; los del roadmap (PLANNED_CERTIFICATIONS) son anillos
 * punteados que orbitan, nunca links. Los grupos salen de los datos: un emisor
 * nuevo sólo necesita su entrada en ISSUER_COLORS.
 */
import {
  CERTIFICATIONS,
  CERTIFICATION_TRACKS,
  DEFAULT_VERIFIER,
  PLANNED_CERTIFICATIONS,
} from "@utils/constants";
import type { Certification, PlannedCertification } from "@utils/constants";

/**
 * Color de marca por emisor, legible sobre el surface. Linux Foundation usa un
 * azul Kubernetes aclarado (#003778 da 1.59:1, #326CE5 4.05:1; este 5.96:1);
 * Microsoft, el azul de su logo en vez del gris de SimpleIcons.
 */
const ISSUER_COLORS: Record<string, string> = {
  "Linux Foundation": "#5B8DEF",
  AWS: "#FF9900",
  "Google Cloud": "#4285F4",
  Microsoft: "#00A4EF",
  Anthropic: "#D97757",
};

/** Verificadores presentes, para la nota del pie (hoy: Credly y Microsoft Learn) */
const verifiers = [...new Set(CERTIFICATIONS.map((cert) => cert.verifier ?? DEFAULT_VERIFIER))];

interface Group {
  issuer: string;
  color: string;
  icon: string;
  certs: Certification[];
  planned: PlannedCertification[];
}

// En el orden en que aparece cada emisor en CERTIFICATIONS
const groups = CERTIFICATIONS.reduce<Group[]>((acc, cert) => {
  const existing = acc.find((g) => g.issuer === cert.issuer);
  if (existing) existing.certs.push(cert);
  else acc.push({ issuer: cert.issuer, color: ISSUER_COLORS[cert.issuer] ?? cert.accentColor, icon: cert.svgPath, certs: [cert], planned: [] });
  return acc;
}, []);
for (const planned of PLANNED_CERTIFICATIONS) {
  groups.find((g) => g.issuer === planned.issuer)?.planned.push(planned);
}
---

<section class="split-section" aria-labelledby="certs-section-heading">
  <div class="page-section-head">
    <span class="stage-eyebrow text-tertiary">03 — credentials · $ kubectl get certs --all-namespaces</span>
    <h2 id="certs-section-heading" class="stage-h2">
      {CERTIFICATIONS.length} verified. {PLANNED_CERTIFICATIONS.length} on the roadmap.
    </h2>
  </div>

  <div class="cred-groups">
    {groups.map((group) => {
      const track = CERTIFICATION_TRACKS[group.issuer];
      return (
        <div class="cred-group scroll-reveal" style={`--c: ${group.color}`}>
          <div class="cred-issuer">
            <span class="cred-issuer-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={group.icon} /></svg>
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <h3 class="cred-issuer-name">{group.issuer}</h3>
              <span class="dep-slug">
                {group.certs.length} earned{group.planned.length > 0 && ` · ${group.planned.length} on the roadmap`}
              </span>
            </div>
            {track && (
              <div class="cred-track" title={`${track.label}: ${group.certs.length} of ${track.total} required certifications earned`}>
                <span class="cred-track-label">
                  <span class="material-symbols-outlined text-[16px]" aria-hidden="true">{track.icon}</span>
                  {track.label} {group.certs.length}/{track.total}
                </span>
                <span class="cred-track-cells" aria-hidden="true">
                  {Array.from({ length: track.total }, (_, i) => (
                    <i class:list={[i < group.certs.length && "is-on"]} style={`--i: ${i}`}></i>
                  ))}
                </span>
              </div>
            )}
          </div>

          <ul class="cred-grid">
            {group.certs.map((cert, i) => (
              <li style={`--i: ${i}`}>
                <a
                  href={cert.credentialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cred"
                  data-tilt
                  aria-label={`Verify ${cert.title} on ${cert.verifier ?? DEFAULT_VERIFIER}`}
                >
                  <span class="cred-badge">
                    <img src={cert.badgeUrl} alt="" width="88" height="88" loading="lazy" decoding="async" data-cert-badge />
                    <span class="cred-fallback" aria-hidden="true">{cert.code}</span>
                  </span>
                  <span class="cred-code">{cert.code}</span>
                  <span class="cred-title">{cert.title}</span>
                  <span class="material-symbols-outlined cred-verify" aria-hidden="true">north_east</span>
                </a>
              </li>
            ))}
            {group.planned.map((cert, i) => (
              <li style={`--i: ${group.certs.length + i}`}>
                <div class="cred is-planned" aria-label={`On the roadmap: ${cert.title}`}>
                  <span class="cred-badge cred-orbit" aria-hidden="true"><span>{cert.code}</span></span>
                  <span class="cred-code">planned</span>
                  <span class="cred-title">{cert.title}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>

  <p class="stage-note mt-8 normal-case tracking-normal">
    Every badge links to its verification on {verifiers.join(" or ")}.
  </p>
</section>

<script>
  /**
   * 1. Fallback del badge: si la imagen de Credly no carga, se oculta y queda el
   *    código. En un <script> y no con onerror= inline, para que siga valiendo el
   *    día que la CSP deje de permitir 'unsafe-inline'.
   * 2. Inclinación hacia el cursor de los pods (`[data-tilt]`): sólo con puntero
   *    fino y sin reduced-motion. Delegado en document: sobrevive a las View
   *    Transitions sin re-bind.
   */
  function initCertBadgeFallback() {
    document.querySelectorAll<HTMLImageElement>("img[data-cert-badge]").forEach((img) => {
      const showFallback = () => img.closest(".cred-badge")?.classList.add("is-broken");
      if (img.complete && img.naturalWidth === 0) showFallback();
      img.addEventListener("error", showFallback, { once: true });
    });
  }
  initCertBadgeFallback();
  document.addEventListener("astro:page-load", initCertBadgeFallback);

  const canTilt = matchMedia("(pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches;
  let tilted: HTMLElement | null = null;
  if (canTilt) {
    document.addEventListener("pointermove", (e) => {
      const el = e.target instanceof Element ? e.target.closest<HTMLElement>("[data-tilt]") : null;
      if (tilted && tilted !== el) { tilted.style.removeProperty("--rx"); tilted.style.removeProperty("--ry"); }
      tilted = el;
      if (!el) return;
      const r = el.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
      el.style.setProperty("--rx", `${(-y * 10).toFixed(2)}deg`);
      el.style.setProperty("--ry", `${(x * 12).toFixed(2)}deg`);
    }, { passive: true });
  }
</script>
