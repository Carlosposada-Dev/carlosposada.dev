---
/**
 * Certifications.astro
 * Full-width credential wall on the About page.
 * Renders every cert in CERTIFICATIONS as a large badge card, grouped by
 * issuer (AWS · Google Cloud · Microsoft · Anthropic), each linking to its
 * verification page — Credly for most, Microsoft Learn for Microsoft.
 * Groups are derived from the data — adding a cert with a new issuer only
 * requires an entry in ISSUER_STYLES below.
 * PLANNED_CERTIFICATIONS render as dashed ghost cards at the end of their
 * group (not links, clearly marked as roadmap — never as earned).
 */
import { CERTIFICATIONS, DEFAULT_VERIFIER, PLANNED_CERTIFICATIONS } from "@utils/constants";
import type { Certification, PlannedCertification } from "@utils/constants";

/** Brand color per issuer — drives the group panel tint and border */
const ISSUER_STYLES: Record<string, { color: string; bg: string; border: string }> = {
  AWS: { color: "#FF9900", bg: "rgba(255,153,0,0.06)", border: "rgba(255,153,0,0.2)" },
  "Google Cloud": { color: "#4285F4", bg: "rgba(66,133,244,0.06)", border: "rgba(66,133,244,0.2)" },
  // #00A4EF (el azul del logo) en vez del gris de SimpleIcons: legible sobre
  // fondo oscuro y suficientemente distinto del azul de Google
  Microsoft: { color: "#00A4EF", bg: "rgba(0,164,239,0.06)", border: "rgba(0,164,239,0.2)" },
  Anthropic: { color: "#D97757", bg: "rgba(217,119,87,0.06)", border: "rgba(217,119,87,0.2)" },
};

/** Verificadores presentes, para la nota del pie (hoy: Credly y Microsoft Learn) */
const verifiers = [
  ...new Set(CERTIFICATIONS.map((cert) => cert.verifier ?? DEFAULT_VERIFIER)),
];

interface Group {
  issuer: string;
  color: string;
  bg: string;
  border: string;
  certs: Certification[];
  planned: PlannedCertification[];
}

// Group in the order issuers first appear in CERTIFICATIONS
const groups = CERTIFICATIONS.reduce<Group[]>((acc, cert) => {
  const existing = acc.find((g) => g.issuer === cert.issuer);
  if (existing) {
    existing.certs.push(cert);
    return acc;
  }
  const style = ISSUER_STYLES[cert.issuer] ?? {
    color: cert.accentColor,
    bg: "rgba(255,255,255,0.03)",
    border: "rgba(255,255,255,0.12)",
  };
  acc.push({ issuer: cert.issuer, ...style, certs: [cert], planned: [] });
  return acc;
}, []);

// Attach roadmap entries to their issuer group (ignored if the issuer has no earned cert yet)
for (const planned of PLANNED_CERTIFICATIONS) {
  groups.find((g) => g.issuer === planned.issuer)?.planned.push(planned);
}
---

<section
  class="scroll-reveal fade-up"
  style="--reveal-delay: 200ms;"
  aria-labelledby="certs-section-heading"
>
  <!-- Section header -->
  <div class="flex items-center gap-4 mb-10">
    <div>
      <p class="section-label text-tertiary mb-1">Verified Credentials</p>
      <h2
        id="certs-section-heading"
        class="font-headline text-2xl md:text-3xl font-bold text-on-surface"
      >
        Cloud &amp; AI Certifications
      </h2>
    </div>
    <div class="flex-1 h-px bg-outline-variant/30 hidden sm:block" aria-hidden="true"></div>
    <!-- Total count badge -->
    <span
      class="shrink-0 px-3 py-1 rounded-lg font-mono text-xs font-bold
             bg-surface-container border border-outline-variant/30 text-on-surface-variant"
    >
      {CERTIFICATIONS.length} active
    </span>
  </div>

  <!-- Issuer groups -->
  <div class="space-y-8">
    {groups.filter((g) => g.certs.length > 0).map((group, gi) => (
      <div
        class="rounded-2xl border p-6 md:p-8"
        style={`background: ${group.bg}; border-color: ${group.border};`}
      >
        <!-- Issuer label row -->
        <div class="flex items-center gap-3 mb-6">
          <svg
            class="w-5 h-5 fill-current shrink-0"
            style={`color: ${group.color}`}
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d={group.certs[0].svgPath} />
          </svg>
          <span
            class="font-headline font-bold text-base tracking-wide"
            style={`color: ${group.color}`}
          >
            {group.issuer}
          </span>
          <span class="font-mono text-xs text-on-surface-variant/50">
            {group.certs.length} certification{group.certs.length > 1 ? "s" : ""}
            {group.planned.length > 0 && ` · ${group.planned.length} on the roadmap`}
          </span>
        </div>

        <!-- Badge grid — responsive: 2 col mobile → 3 col md → up to 5 col xl -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-4">
          {group.certs.map((cert, i) => (
            <a
              href={cert.credentialUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Verify ${cert.title} on ${cert.verifier ?? DEFAULT_VERIFIER}`}
              class="group relative flex flex-col items-center gap-3 p-4 rounded-xl
                     bg-surface-container border border-outline-variant/20
                     hover:border-primary/50 hover:shadow-glow-primary hover:-translate-y-1
                     transition-all duration-300 text-center"
              style={`--reveal-delay: ${(gi * 5 + i) * 60}ms;`}
            >
              <!-- Badge image -->
              <div class="w-20 h-20 md:w-24 md:h-24 relative">
                <img
                  src={cert.badgeUrl}
                  alt={`${cert.title} certification badge`}
                  class="w-full h-full object-contain
                         group-hover:scale-110 transition-transform duration-300 drop-shadow-lg"
                  loading="lazy"
                  decoding="async"
                  data-cert-badge
                />
                <!-- Fallback: code label -->
                <div
                  class="absolute inset-0 flex items-center justify-center
                         font-mono text-sm font-bold opacity-0 transition-opacity"
                  style={`color: ${cert.accentColor}`}
                  aria-hidden="true"
                >
                  {cert.code}
                </div>
              </div>

              <!-- Cert title -->
              <p class="font-headline text-xs font-bold text-on-surface/80
                        group-hover:text-primary transition-colors duration-200
                        leading-snug line-clamp-2">
                {cert.title}
              </p>

              <!-- Code chip -->
              <span
                class="inline-block px-2 py-0.5 rounded font-mono text-[10px] font-bold
                       tracking-widest uppercase border"
                style={`color: ${cert.accentColor}; border-color: ${cert.accentColor}40; background: ${cert.accentColor}15;`}
              >
                {cert.code}
              </span>

              <!-- Hover overlay: "Verify" label -->
              <span
                class="absolute top-2 right-2 opacity-0 group-hover:opacity-100
                       transition-opacity duration-200
                       material-symbols-outlined text-primary/70"
                style="font-size: 0.9rem;"
                aria-hidden="true"
              >
                open_in_new
              </span>
            </a>
          ))}

          <!-- Roadmap (not earned yet) — dashed ghost cards, never links -->
          {group.planned.map((cert, i) => (
            <div
              class="relative flex flex-col items-center justify-center gap-3 p-4 rounded-xl
                     border border-dashed border-outline-variant/25 bg-surface-container/30
                     text-center"
              aria-label={`Planned certification: ${cert.title}`}
            >
              <!-- Placeholder mark -->
              <div class="w-20 h-20 md:w-24 md:h-24 flex items-center justify-center">
                <span
                  class="material-symbols-outlined opacity-30"
                  style={`font-size: 2.5rem; color: ${cert.accentColor};`}
                  aria-hidden="true"
                >
                  hourglass_top
                </span>
              </div>

              <p class="font-headline text-xs font-bold text-on-surface/35
                        leading-snug line-clamp-2">
                {cert.title}
              </p>

              <span
                class="inline-block px-2 py-0.5 rounded font-mono text-[10px] font-bold
                       tracking-widest uppercase border border-dashed
                       border-outline-variant/30 text-on-surface-variant/40"
              >
                In progress
              </span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Footer note — los verificadores salen de los datos, no hardcodeados -->
  <p class="text-center text-xs text-on-surface-variant/40 font-mono mt-6">
    All credentials independently verifiable on {verifiers.join(" and ")} — click any badge
  </p>
</section>

<script>
  /**
   * Badge fallback: if a Credly image fails to load, fade it out and reveal the
   * cert code underneath. Replaces an inline onerror= handler so the component
   * keeps working if 'unsafe-inline' is ever dropped from the CSP.
   */
  function initCertBadgeFallback() {
    document.querySelectorAll<HTMLImageElement>("img[data-cert-badge]").forEach((img) => {
      const showFallback = () => {
        img.style.opacity = "0";
        const fallback = img.nextElementSibling as HTMLElement | null;
        if (fallback) fallback.style.opacity = "1";
      };
      // Already failed before this script ran
      if (img.complete && img.naturalWidth === 0) showFallback();
      img.addEventListener("error", showFallback, { once: true });
    });
  }

  initCertBadgeFallback();
  document.addEventListener("astro:page-load", initCertBadgeFallback);
</script>
